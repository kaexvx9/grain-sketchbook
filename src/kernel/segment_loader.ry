//! Segment Loader for Process Spawning
//! Why: Extract segment loading logic from syscall_spawn.

const std = @import("std");
const Debug = @import("debug.zig");
const elf_parser = @import("elf_parser.zig");
const BasinKernel = @import("basin_kernel.zig").BasinKernel;
const MapFlags = @import("basin_kernel.zig").MapFlags;
const syscall_map = @import("basin_kernel.zig").syscall_map;

const PAGE_SIZE: u64 = 4096;
const MAX_SEG: u32 = 1024 * 1024;

/// Load a single program segment into VM memory.
/// Why: Extract segment loading logic to reduce nesting in syscall_spawn.
pub fn load_program_segment(
    segment: elf_parser.ProgramSegment,
    executable: u64,
    read_fn: *const fn (u64, u32, []u8) ?u32,
    write_fn: *const fn (u64, u32, []const u8) ?u32,
    kernel: *BasinKernel,
) bool {
    Debug.kassert(segment.valid, "Segment not valid", .{});
    Debug.kassert(segment.p_type == 1, "Segment not PT_LOAD", .{});

    const aligned_size = ((segment.p_memsz + PAGE_SIZE - 1) / PAGE_SIZE) * PAGE_SIZE;
    const map_flags = make_map_flags(segment.p_flags);
    const flags_u64 = @as(u64, @intCast(@as(u32, @bitCast(map_flags))));

    const result = syscall_map(kernel, segment.p_vaddr, aligned_size, flags_u64, 0) catch return false;
    if (result != .success) return false;

    return load_segment_data(segment, executable, read_fn, write_fn);
}

fn make_map_flags(p_flags: u32) MapFlags {
    return MapFlags{
        .read = (p_flags & 0x4) != 0,
        .write = (p_flags & 0x2) != 0,
        .execute = (p_flags & 0x1) != 0,
        .shared = false,
        ._padding = 0,
    };
}

/// Load segment data from ELF file into VM memory.
/// Why: Extract data loading logic to reduce nesting.
fn load_segment_data(
    segment: elf_parser.ProgramSegment,
    executable: u64,
    read_fn: *const fn (u64, u32, []u8) ?u32,
    write_fn: *const fn (u64, u32, []const u8) ?u32,
) bool {
    const data_size = @as(u32, @intCast(segment.p_filesz));
    if (data_size == 0) return zero_fill_bss(segment, write_fn);
    if (data_size > MAX_SEG) return false;

    var buf: [MAX_SEG]u8 = undefined;
    const n = read_fn(executable + segment.p_offset, data_size, buf[0..data_size]) orelse return false;
    if (n != data_size) return false;

    const w = write_fn(segment.p_vaddr, data_size, buf[0..data_size]) orelse return false;
    if (w != data_size) return false;

    return zero_fill_bss(segment, write_fn);
}

/// Zero-fill BSS section (memory beyond file size).
/// Why: Extract BSS zero-filling logic to reduce nesting.
fn zero_fill_bss(
    segment: elf_parser.ProgramSegment,
    write_fn: *const fn (u64, u32, []const u8) ?u32,
) bool {
    if (segment.p_memsz <= segment.p_filesz) return true;

    const fill_size = @as(u32, @intCast(segment.p_memsz - segment.p_filesz));
    if (fill_size > MAX_SEG) return false;

    var zeros: [MAX_SEG]u8 = undefined;
    @memset(zeros[0..fill_size], 0);

    const addr = segment.p_vaddr + segment.p_filesz;
    const w = write_fn(addr, fill_size, zeros[0..fill_size]) orelse return false;
    return w == fill_size;
}
