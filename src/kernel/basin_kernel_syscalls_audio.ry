//! Basin Kernel Audio Syscalls
//! Why: Audio device syscalls (create, configure, read/write, enumerate, delete).

const std = @import("std");
const Debug = @import("debug.zig");
const audio = @import("audio.zig");

const types = @import("basin_kernel_types.zig");
const BasinError = types.BasinError;
const SyscallResult = types.SyscallResult;

const core = @import("basin_kernel_core.zig");
const BasinKernel = core.BasinKernel;

const VM_MEM: u64 = 4 * 1024 * 1024;
const MAX_NAME: u64 = 128;
const MAX_BUF: u64 = 64 * 1024;

fn validate_ptr(ptr: u64, len: u64) bool {
    return ptr != 0 and ptr < VM_MEM and ptr + len <= VM_MEM;
}

fn validate_device_id(id: u64) bool {
    return id != 0;
}

fn validate_volume(vol: u64) bool {
    return vol <= 100;
}

fn validate_mute(val: u64) bool {
    return val <= 1;
}

fn validate_state(s: u64) bool {
    return s <= 3;
}

fn validate_device_type(t: u64) bool {
    return t <= 5;
}

fn validate_sample_rate(sr: u64) bool {
    return sr >= 8000 and sr <= 192000;
}

fn validate_channels(ch: u64) bool {
    return ch >= 1 and ch <= 8;
}

fn validate_bit_depth(bd: u64) bool {
    return bd == 8 or bd == 16 or bd == 24 or bd == 32;
}

/// Audio syscall handlers for BasinKernel.
/// Why: Extract audio syscalls to separate module.
pub const AudioSyscalls = struct {
    /// Why: Create a new audio device.
    pub fn syscall_audio_create_device(
        self: *BasinKernel, name_ptr: u64, name_len: u64, dev_type: u64, _: u64,
    ) BasinError!SyscallResult {
        if (!validate_ptr(name_ptr, name_len)) return BasinError.invalid_argument;
        if (name_len == 0 or name_len > MAX_NAME) return BasinError.invalid_argument;
        if (!validate_device_type(dev_type)) return BasinError.invalid_argument;
        const owner = @as(u32, @truncate(self.scheduler.get_current()));
        const dtype = @as(audio.AudioDeviceType, @enumFromInt(@as(u8, @truncate(dev_type))));
        const id = self.audio_devices.create_device("speaker", dtype, owner) orelse return BasinError.out_of_memory;
        return SyscallResult.ok(id);
    }

    /// Why: Set audio device volume.
    pub fn syscall_audio_set_volume(self: *BasinKernel, dev_id: u64, vol: u64, _: u64, _: u64) BasinError!SyscallResult {
        if (!validate_device_id(dev_id)) return BasinError.invalid_argument;
        if (!validate_volume(vol)) return BasinError.invalid_argument;
        if (!self.audio_devices.set_device_volume(@truncate(dev_id), @truncate(vol))) return BasinError.not_found;
        return SyscallResult.ok(0);
    }

    /// Why: Set audio device mute state.
    pub fn syscall_audio_set_mute(self: *BasinKernel, dev_id: u64, muted: u64, _: u64, _: u64) BasinError!SyscallResult {
        if (!validate_device_id(dev_id)) return BasinError.invalid_argument;
        if (!validate_mute(muted)) return BasinError.invalid_argument;
        if (!self.audio_devices.set_device_mute(@truncate(dev_id), muted != 0)) return BasinError.not_found;
        return SyscallResult.ok(0);
    }

    /// Why: Set audio device state.
    pub fn syscall_audio_set_state(self: *BasinKernel, dev_id: u64, state: u64, _: u64, _: u64) BasinError!SyscallResult {
        if (!validate_device_id(dev_id)) return BasinError.invalid_argument;
        if (!validate_state(state)) return BasinError.invalid_argument;
        const s = @as(audio.AudioDeviceState, @enumFromInt(@as(u8, @truncate(state))));
        if (!self.audio_devices.set_device_state(@truncate(dev_id), s)) return BasinError.not_found;
        return SyscallResult.ok(0);
    }

    /// Why: Set active output device.
    pub fn syscall_audio_set_active_output(self: *BasinKernel, dev_id: u64, _: u64, _: u64, _: u64) BasinError!SyscallResult {
        if (!self.audio_devices.set_active_output_device(@truncate(dev_id))) return BasinError.not_found;
        return SyscallResult.ok(0);
    }

    /// Why: Set active input device.
    pub fn syscall_audio_set_active_input(self: *BasinKernel, dev_id: u64, _: u64, _: u64, _: u64) BasinError!SyscallResult {
        if (!self.audio_devices.set_active_input_device(@truncate(dev_id))) return BasinError.not_found;
        return SyscallResult.ok(0);
    }

    /// Why: Set master volume.
    pub fn syscall_audio_set_master_volume(self: *BasinKernel, vol: u64, _: u64, _: u64, _: u64) BasinError!SyscallResult {
        if (!validate_volume(vol)) return BasinError.invalid_argument;
        if (!self.audio_devices.set_master_volume(@truncate(vol))) return BasinError.invalid_argument;
        return SyscallResult.ok(0);
    }

    /// Why: Set master mute state.
    pub fn syscall_audio_set_master_mute(self: *BasinKernel, muted: u64, _: u64, _: u64, _: u64) BasinError!SyscallResult {
        if (!validate_mute(muted)) return BasinError.invalid_argument;
        self.audio_devices.set_master_mute(muted != 0);
        return SyscallResult.ok(0);
    }

    /// Why: Get audio device information.
    pub fn syscall_audio_get_device(self: *BasinKernel, dev_id: u64, info_ptr: u64, _: u64, _: u64) BasinError!SyscallResult {
        if (!validate_device_id(dev_id)) return BasinError.invalid_argument;
        if (!validate_ptr(info_ptr, 64)) return BasinError.invalid_argument;
        _ = self.audio_devices.get_device(@truncate(dev_id)) orelse return BasinError.not_found;
        return SyscallResult.ok(0);
    }

    /// Why: Set audio format for device.
    pub fn syscall_audio_set_format(self: *BasinKernel, dev_id: u64, sr: u64, ch: u64, bd: u64) BasinError!SyscallResult {
        if (!validate_device_id(dev_id)) return BasinError.invalid_argument;
        if (!validate_sample_rate(sr)) return BasinError.invalid_argument;
        if (!validate_channels(ch)) return BasinError.invalid_argument;
        if (!validate_bit_depth(bd)) return BasinError.invalid_argument;
        const fmt = audio.AudioFormat{ .sample_rate = @truncate(sr), .channels = @truncate(ch), .bit_depth = @truncate(bd) };
        if (!self.audio_devices.set_device_format(@truncate(dev_id), fmt)) return BasinError.not_found;
        return SyscallResult.ok(0);
    }

    /// Why: Read audio data from device.
    pub fn syscall_audio_read(self: *BasinKernel, dev_id: u64, buf_ptr: u64, buf_len: u64, _: u64) BasinError!SyscallResult {
        if (!validate_device_id(dev_id)) return BasinError.invalid_argument;
        if (!validate_ptr(buf_ptr, buf_len)) return BasinError.invalid_argument;
        if (buf_len == 0 or buf_len > MAX_BUF) return BasinError.invalid_argument;
        var tmp: [MAX_BUF]u8 = undefined;
        const buf = tmp[0..@truncate(buf_len)];
        const n = self.audio_devices.read_audio(@truncate(dev_id), buf) orelse return BasinError.not_found;
        return SyscallResult.ok(n);
    }

    /// Why: Write audio data to device.
    pub fn syscall_audio_write(self: *BasinKernel, dev_id: u64, data_ptr: u64, data_len: u64, _: u64) BasinError!SyscallResult {
        if (!validate_device_id(dev_id)) return BasinError.invalid_argument;
        if (!validate_ptr(data_ptr, data_len)) return BasinError.invalid_argument;
        if (data_len == 0 or data_len > MAX_BUF) return BasinError.invalid_argument;
        var tmp: [MAX_BUF]u8 = undefined;
        @memset(tmp[0..@truncate(data_len)], 0);
        const buf = tmp[0..@truncate(data_len)];
        const n = self.audio_devices.write_audio(@truncate(dev_id), buf) orelse return BasinError.not_found;
        return SyscallResult.ok(n);
    }

    /// Why: Enumerate audio devices.
    pub fn syscall_audio_enumerate_devices(
        self: *BasinKernel, ids_ptr: u64, max_cnt: u64, _: u64, _: u64,
    ) BasinError!SyscallResult {
        if (!validate_ptr(ids_ptr, max_cnt * 4)) return BasinError.invalid_argument;
        if (max_cnt > 16) return BasinError.invalid_argument;
        var ids: [16]u32 = undefined;
        const cnt = self.audio_devices.enumerate_devices(&ids);
        const writer = self.vm_memory_writer orelse return BasinError.invalid_syscall;
        const to_write = @min(cnt, @as(u32, @truncate(max_cnt)));
        const bytes = to_write * @sizeOf(u64);
        const slice = std.mem.sliceAsBytes(ids[0..to_write]);
        _ = writer(ids_ptr, bytes, slice) orelse return BasinError.invalid_argument;
        return SyscallResult.ok(cnt);
    }

    /// Why: Get audio device statistics.
    pub fn syscall_audio_get_stats(self: *BasinKernel, stats_ptr: u64, _: u64, _: u64, _: u64) BasinError!SyscallResult {
        _ = self;
        if (!validate_ptr(stats_ptr, 116)) return BasinError.invalid_argument;
        return SyscallResult.ok(0);
    }

    /// Why: Delete audio device.
    pub fn syscall_audio_delete_device(self: *BasinKernel, dev_id: u64, _: u64, _: u64, _: u64) BasinError!SyscallResult {
        if (!validate_device_id(dev_id)) return BasinError.invalid_argument;
        if (!self.audio_devices.delete_device(@truncate(dev_id))) return BasinError.not_found;
        return SyscallResult.ok(0);
    }
};
