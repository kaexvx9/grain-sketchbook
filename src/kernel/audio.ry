//! Audio Device Management
//! Why: Manage audio devices for multimedia applications.

const std = @import("std");
const Debug = @import("debug.zig");
const AudioDeviceStats = @import("audio_device_stats.zig").AudioDeviceStats;

const MAX_DEVICES: u32 = 4;
const MAX_NAME_LEN: u32 = 128;
const MAX_BUFFER: u32 = 4 * 1024;

/// Audio device type.
/// Why: Categorize audio devices.
pub const AudioDeviceType = enum(u8) { unknown = 0, speaker = 1, headphone = 2, microphone = 3, bluetooth = 4, usb = 5 };

/// Audio device state.
/// Why: Track device state.
pub const AudioDeviceState = enum(u8) { disconnected = 0, connected = 1, active = 2, disabled = 3 };

/// Audio format.
/// Why: Specify audio format.
pub const AudioFormat = struct {
    sample_rate: u32,
    channels: u32,
    bit_depth: u32,

    /// Initialize audio format with defaults.
    /// Why: Explicit initialization.
    pub fn init() AudioFormat {
        return AudioFormat{ .sample_rate = 44100, .channels = 2, .bit_depth = 16 };
    }

    /// Validate audio format.
    /// Why: Ensure format is valid.
    pub fn is_valid(self: *const AudioFormat) bool {
        if (self.sample_rate < 8000 or self.sample_rate > 192000) return false;
        if (self.channels == 0 or self.channels > 8) return false;
        return self.bit_depth == 8 or self.bit_depth == 16 or self.bit_depth == 24 or self.bit_depth == 32;
    }
};

/// Audio device entry.
/// Why: Track audio device configuration and state.
pub const AudioDevice = struct {
    device_id: u32,
    name: [MAX_NAME_LEN]u8,
    device_type: AudioDeviceType,
    state: AudioDeviceState,
    volume: u32,
    muted: bool,
    allocated: bool,
    owner_process_id: u32,
    format: AudioFormat,
    input_buffer: [MAX_BUFFER]u8,
    input_buffer_len: u32,
    output_buffer: [MAX_BUFFER]u8,
    output_buffer_len: u32,

    /// Initialize empty audio device entry.
    /// Why: Explicit initialization.
    pub fn init() AudioDevice {
        return AudioDevice{
            .device_id = 0,
            .name = [_]u8{0} ** MAX_NAME_LEN,
            .device_type = .unknown,
            .state = .disconnected,
            .volume = 50,
            .muted = false,
            .allocated = false,
            .owner_process_id = 0,
            .format = AudioFormat.init(),
            .input_buffer = [_]u8{0} ** MAX_BUFFER,
            .input_buffer_len = 0,
            .output_buffer = [_]u8{0} ** MAX_BUFFER,
            .output_buffer_len = 0,
        };
    }

    /// Set device name.
    /// Why: Configure device name.
    pub fn set_name(self: *AudioDevice, name: []const u8) bool {
        Debug.kassert(self.allocated, "Entry not allocated", .{});
        if (name.len == 0 or name.len >= MAX_NAME_LEN) return false;
        @memset(&self.name, 0);
        std.mem.copyForwards(u8, self.name[0..name.len], name);
        return true;
    }

    /// Get device name.
    /// Why: Retrieve device name.
    pub fn get_name(self: *const AudioDevice) []const u8 {
        Debug.kassert(self.allocated, "Entry not allocated", .{});
        var len: u32 = 0;
        while (len < MAX_NAME_LEN and self.name[len] != 0) : (len += 1) {}
        return self.name[0..len];
    }

    /// Set audio format.
    /// Why: Configure audio format.
    pub fn set_format(self: *AudioDevice, format: AudioFormat) bool {
        Debug.kassert(self.allocated, "Entry not allocated", .{});
        if (!format.is_valid()) return false;
        self.format = format;
        return true;
    }

    /// Get audio format.
    /// Why: Retrieve audio format.
    pub fn get_format(self: *const AudioDevice) AudioFormat {
        Debug.kassert(self.allocated, "Entry not allocated", .{});
        return self.format;
    }
};

/// Audio device manager.
/// Why: Manage all audio devices.
pub const AudioDeviceManager = struct {
    devices: [MAX_DEVICES]AudioDevice,
    next_device_id: u32,
    master_volume: u32,
    master_muted: bool,
    active_output_device_id: u32,
    active_input_device_id: u32,
    initialized: bool,
    stats: AudioDeviceStats,

    /// Initialize audio device manager.
    /// Why: Set up manager state.
    pub fn init() AudioDeviceManager {
        return AudioDeviceManager{
            .devices = [_]AudioDevice{AudioDevice.init()} ** MAX_DEVICES,
            .next_device_id = 1,
            .master_volume = 50,
            .master_muted = false,
            .active_output_device_id = 0,
            .active_input_device_id = 0,
            .initialized = true,
            .stats = AudioDeviceStats.init(),
        };
    }

    /// Create a new audio device.
    /// Why: Add a new audio device.
    pub fn create_device(self: *AudioDeviceManager, name: []const u8, dtype: AudioDeviceType, owner: u32) ?u32 {
        Debug.kassert(self.initialized, "Manager not initialized", .{});
        if (name.len == 0 or name.len >= MAX_NAME_LEN) {
            self.stats.record_creation_error();
            return null;
        }
        for (&self.devices) |*d| {
            if (!d.allocated) {
                d.* = AudioDevice.init();
                d.allocated = true;
                d.device_id = self.next_device_id;
                d.device_type = dtype;
                d.owner_process_id = owner;
                if (!d.set_name(name)) {
                    d.allocated = false;
                    self.stats.record_creation_error();
                    return null;
                }
                const id = self.next_device_id;
                self.next_device_id = if (self.next_device_id == 0) 1 else self.next_device_id + 1;
                self.stats.record_device_created();
                return id;
            }
        }
        self.stats.record_creation_error();
        return null;
    }

    /// Get device by ID.
    /// Why: Retrieve device entry.
    pub fn get_device(self: *AudioDeviceManager, id: u32) ?*AudioDevice {
        Debug.kassert(self.initialized, "Manager not initialized", .{});
        if (id == 0) return null;
        for (&self.devices) |*d| {
            if (d.allocated and d.device_id == id) return d;
        }
        return null;
    }

    /// Set device volume.
    /// Why: Control device volume.
    pub fn set_device_volume(self: *AudioDeviceManager, id: u32, vol: u32) bool {
        Debug.kassert(self.initialized, "Manager not initialized", .{});
        if (vol > 100) {
            self.stats.record_configuration_error();
            return false;
        }
        const d = self.get_device(id) orelse {
            self.stats.record_configuration_error();
            return false;
        };
        if (d.volume != vol) self.stats.record_volume_change();
        d.volume = vol;
        return true;
    }

    /// Set device mute state.
    /// Why: Control device mute state.
    pub fn set_device_mute(self: *AudioDeviceManager, id: u32, muted: bool) bool {
        Debug.kassert(self.initialized, "Manager not initialized", .{});
        const d = self.get_device(id) orelse {
            self.stats.record_configuration_error();
            return false;
        };
        if (d.muted != muted) self.stats.record_mute_toggle();
        d.muted = muted;
        return true;
    }

    /// Set device state.
    /// Why: Control device state.
    pub fn set_device_state(self: *AudioDeviceManager, id: u32, state: AudioDeviceState) bool {
        Debug.kassert(self.initialized, "Manager not initialized", .{});
        const d = self.get_device(id) orelse {
            self.stats.record_configuration_error();
            return false;
        };
        if (d.state != state) {
            switch (state) {
                .connected => self.stats.record_connected_transition(),
                .active => self.stats.record_active_transition(),
                .disabled => self.stats.record_disabled_transition(),
                .disconnected => {},
            }
        }
        d.state = state;
        return true;
    }

    /// Set active output device.
    /// Why: Select active output device.
    pub fn set_active_output_device(self: *AudioDeviceManager, id: u32) bool {
        Debug.kassert(self.initialized, "Manager not initialized", .{});
        if (id == 0) {
            self.active_output_device_id = 0;
            return true;
        }
        const d = self.get_device(id) orelse return false;
        const t = d.device_type;
        if (t != .speaker and t != .headphone and t != .bluetooth and t != .usb) return false;
        self.active_output_device_id = id;
        return true;
    }

    /// Set active input device.
    /// Why: Select active input device.
    pub fn set_active_input_device(self: *AudioDeviceManager, id: u32) bool {
        Debug.kassert(self.initialized, "Manager not initialized", .{});
        if (id == 0) {
            self.active_input_device_id = 0;
            return true;
        }
        const d = self.get_device(id) orelse return false;
        const t = d.device_type;
        if (t != .microphone and t != .bluetooth and t != .usb) return false;
        self.active_input_device_id = id;
        return true;
    }

    /// Set master volume.
    /// Why: Control master volume.
    pub fn set_master_volume(self: *AudioDeviceManager, vol: u32) bool {
        Debug.kassert(self.initialized, "Manager not initialized", .{});
        if (vol > 100) return false;
        self.master_volume = vol;
        return true;
    }

    /// Set master mute state.
    /// Why: Control master mute state.
    pub fn set_master_mute(self: *AudioDeviceManager, muted: bool) void {
        Debug.kassert(self.initialized, "Manager not initialized", .{});
        self.master_muted = muted;
    }

    /// Enumerate all audio devices.
    /// Why: Get list of all allocated devices.
    pub fn enumerate_devices(self: *AudioDeviceManager, ids: []u32) u32 {
        Debug.kassert(self.initialized, "Manager not initialized", .{});
        var count: u32 = 0;
        for (&self.devices) |*d| {
            if (d.allocated and count < ids.len) {
                ids[count] = d.device_id;
                count += 1;
            }
        }
        return count;
    }

    /// Delete device.
    /// Why: Remove audio device.
    pub fn delete_device(self: *AudioDeviceManager, id: u32) bool {
        Debug.kassert(self.initialized, "Manager not initialized", .{});
        for (&self.devices) |*d| {
            if (d.allocated and d.device_id == id) {
                if (self.active_output_device_id == id) self.active_output_device_id = 0;
                if (self.active_input_device_id == id) self.active_input_device_id = 0;
                d.* = AudioDevice.init();
                self.stats.record_device_deleted();
                return true;
            }
        }
        self.stats.record_deletion_error();
        return false;
    }

    /// Set audio format for device.
    /// Why: Configure audio format.
    pub fn set_device_format(self: *AudioDeviceManager, id: u32, format: AudioFormat) bool {
        Debug.kassert(self.initialized, "Manager not initialized", .{});
        if (!format.is_valid()) {
            self.stats.record_configuration_error();
            return false;
        }
        const d = self.get_device(id) orelse {
            self.stats.record_configuration_error();
            return false;
        };
        if (d.set_format(format)) {
            self.stats.record_format_change();
            return true;
        }
        self.stats.record_configuration_error();
        return false;
    }

    /// Read audio data from device.
    /// Why: Read audio data from input device.
    pub fn read_audio(self: *AudioDeviceManager, id: u32, buf: []u8) ?u32 {
        Debug.kassert(self.initialized, "Manager not initialized", .{});
        if (buf.len == 0 or buf.len > MAX_BUFFER) {
            self.stats.record_io_error();
            return null;
        }
        const d = self.get_device(id) orelse {
            self.stats.record_io_error();
            return null;
        };
        const t = d.device_type;
        if (t != .microphone and t != .bluetooth and t != .usb) {
            self.stats.record_io_error();
            return null;
        }
        if (d.state != .active) {
            self.stats.record_io_error();
            return null;
        }
        const n = @min(d.input_buffer_len, @as(u32, @intCast(buf.len)));
        if (n > 0) {
            std.mem.copyForwards(u8, buf[0..n], d.input_buffer[0..n]);
            if (n < d.input_buffer_len) {
                std.mem.copyForwards(u8, d.input_buffer[0..d.input_buffer_len - n], d.input_buffer[n..d.input_buffer_len]);
            }
            d.input_buffer_len -= n;
            self.stats.record_bytes_read(n);
        }
        return n;
    }

    /// Write audio data to device.
    /// Why: Write audio data to output device.
    pub fn write_audio(self: *AudioDeviceManager, id: u32, data: []const u8) ?u32 {
        Debug.kassert(self.initialized, "Manager not initialized", .{});
        if (data.len == 0 or data.len > MAX_BUFFER) {
            self.stats.record_io_error();
            return null;
        }
        const d = self.get_device(id) orelse {
            self.stats.record_io_error();
            return null;
        };
        const t = d.device_type;
        if (t != .speaker and t != .headphone and t != .bluetooth and t != .usb) {
            self.stats.record_io_error();
            return null;
        }
        if (d.state != .active) {
            self.stats.record_io_error();
            return null;
        }
        const avail = MAX_BUFFER - d.output_buffer_len;
        const n = @min(avail, @as(u32, @intCast(data.len)));
        if (n > 0) {
            std.mem.copyForwards(u8, d.output_buffer[d.output_buffer_len..d.output_buffer_len + n], data[0..n]);
            d.output_buffer_len += n;
            self.stats.record_bytes_written(n);
        }
        return n;
    }

    /// Get audio device statistics snapshot.
    /// Why: Provide statistics for userspace queries.
    pub fn get_stats(self: *const AudioDeviceManager) *const AudioDeviceStats {
        Debug.kassert(self.initialized, "Manager not initialized", .{});
        return &self.stats;
    }
};
