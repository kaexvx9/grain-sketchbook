//! Framebuffer driver for Grain Basin Kernel
//! Why: Provide basic pixel-level drawing for GUI display.

const std = @import("std");

pub const FRAMEBUFFER_BASE: u64 = 0x90000000;
pub const FRAMEBUFFER_WIDTH: u32 = 1024;
pub const FRAMEBUFFER_HEIGHT: u32 = 768;
pub const FRAMEBUFFER_BPP: u32 = 4;
pub const FRAMEBUFFER_SIZE: u32 = FRAMEBUFFER_WIDTH * FRAMEBUFFER_HEIGHT * FRAMEBUFFER_BPP;

pub const COLOR_BLACK: u32 = 0x00000000;
pub const COLOR_WHITE: u32 = 0xFFFFFFFF;
pub const COLOR_RED: u32 = 0xFF0000FF;
pub const COLOR_GREEN: u32 = 0x00FF00FF;
pub const COLOR_BLUE: u32 = 0x0000FFFF;
pub const COLOR_DARK_BG: u32 = 0x1E1E2EFF;

/// Framebuffer state.
/// Why: Track framebuffer for drawing operations.
pub const Framebuffer = struct {
    base: u64,
    width: u32,
    height: u32,
    bpp: u32,
    memory: []u8,

    /// Initialize framebuffer.
    /// Why: Set up framebuffer state.
    pub fn init(mem: []u8) Framebuffer {
        std.debug.assert(mem.len >= FRAMEBUFFER_SIZE);
        return Framebuffer{
            .base = FRAMEBUFFER_BASE,
            .width = FRAMEBUFFER_WIDTH,
            .height = FRAMEBUFFER_HEIGHT,
            .bpp = FRAMEBUFFER_BPP,
            .memory = mem[0..FRAMEBUFFER_SIZE],
        };
    }

    /// Clear framebuffer to a color.
    /// Why: Fill entire framebuffer with a single color.
    pub fn clear(self: *const Framebuffer, color: u32) void {
        const r: u8 = @truncate((color >> 24) & 0xFF);
        const g: u8 = @truncate((color >> 16) & 0xFF);
        const b: u8 = @truncate((color >> 8) & 0xFF);
        const a: u8 = @truncate(color & 0xFF);
        var i: u32 = 0;
        while (i < FRAMEBUFFER_SIZE) : (i += 4) {
            self.memory[i] = r;
            self.memory[i + 1] = g;
            self.memory[i + 2] = b;
            self.memory[i + 3] = a;
        }
    }

    /// Draw a single pixel.
    /// Why: Basic pixel-level drawing primitive.
    pub fn draw_pixel(self: *const Framebuffer, x: u32, y: u32, color: u32) void {
        std.debug.assert(x < self.width and y < self.height);
        const off = (y * self.width + x) * self.bpp;
        self.memory[off] = @truncate((color >> 24) & 0xFF);
        self.memory[off + 1] = @truncate((color >> 16) & 0xFF);
        self.memory[off + 2] = @truncate((color >> 8) & 0xFF);
        self.memory[off + 3] = @truncate(color & 0xFF);
    }

    /// Draw a filled rectangle.
    /// Why: Common drawing primitive for UI elements.
    pub fn draw_rect(self: *const Framebuffer, x: u32, y: u32, w: u32, h: u32, color: u32) void {
        std.debug.assert(x + w <= self.width and y + h <= self.height and w > 0 and h > 0);
        var py: u32 = y;
        while (py < y + h) : (py += 1) {
            var px: u32 = x;
            while (px < x + w) : (px += 1) self.draw_pixel(px, py, color);
        }
    }

    /// Draw a test pattern.
    /// Why: Visual verification that framebuffer is working.
    pub fn draw_test_pattern(self: *const Framebuffer) void {
        self.clear(COLOR_DARK_BG);
        const sz: u32 = 100;
        const sp: u32 = 20;
        self.draw_rect(sp, sp, sz, sz, COLOR_RED);
        self.draw_rect(self.width - sz - sp, sp, sz, sz, COLOR_GREEN);
        self.draw_rect(sp, self.height - sz - sp, sz, sz, COLOR_BLUE);
        self.draw_rect(self.width - sz - sp, self.height - sz - sp, sz, sz, COLOR_WHITE);
    }

    /// Draw a single character using 8x8 bitmap font.
    /// Why: Basic text rendering primitive.
    pub fn draw_char(self: *const Framebuffer, ch: u8, x: u32, y: u32, fg: u32, bg: u32) void {
        std.debug.assert(x + 8 <= self.width and y + 8 <= self.height);
        const pat = get_char_pattern(ch);
        const fg_r: u8 = @truncate((fg >> 24) & 0xFF);
        const fg_g: u8 = @truncate((fg >> 16) & 0xFF);
        const fg_b: u8 = @truncate((fg >> 8) & 0xFF);
        const bg_r: u8 = @truncate((bg >> 24) & 0xFF);
        const bg_g: u8 = @truncate((bg >> 16) & 0xFF);
        const bg_b: u8 = @truncate((bg >> 8) & 0xFF);

        var py: u32 = 0;
        while (py < 8) : (py += 1) {
            var px: u32 = 0;
            while (px < 8) : (px += 1) {
                const bit = (pat >> @as(u6, @intCast(63 - (py * 8 + px)))) & 1;
                const off = ((y + py) * self.width + (x + px)) * self.bpp;
                if (bit == 1) {
                    self.memory[off] = fg_r;
                    self.memory[off + 1] = fg_g;
                    self.memory[off + 2] = fg_b;
                } else {
                    self.memory[off] = bg_r;
                    self.memory[off + 1] = bg_g;
                    self.memory[off + 2] = bg_b;
                }
                self.memory[off + 3] = 0xFF;
            }
        }
    }

    /// Draw text string at position.
    /// Why: Render kernel messages and status text.
    pub fn draw_text(self: *const Framebuffer, txt: []const u8, x: u32, y: u32, fg: u32, bg: u32) void {
        std.debug.assert(txt.len > 0 and x < self.width and y < self.height);
        var cx: u32 = x;
        var cy: u32 = y;
        for (txt) |ch| {
            if (ch == '\n') {
                cx = x;
                cy += 8;
                continue;
            }
            if (cx + 8 > self.width) {
                cx = x;
                cy += 8;
            }
            if (cy + 8 > self.height) break;
            self.draw_char(ch, cx, cy, fg, bg);
            cx += 8;
        }
    }

    fn get_char_pattern(ch: u8) u64 {
        return switch (ch) {
            ' ' => 0x0000000000000000,
            '!' => 0x1818181818001800,
            '"' => 0x3636000000000000,
            '#' => 0x36367F36367F3636,
            '$' => 0x0C3E033E301F0C00,
            '%' => 0x006333180C666300,
            '&' => 0x1C361C6E3B331E00,
            '\'' => 0x0C0C180000000000,
            '(' => 0x0C18181818180C00,
            ')' => 0x180C0C0C0C0C1800,
            '*' => 0x00183C7E3C180000,
            '+' => 0x000018187E181800,
            ',' => 0x0000000000180C18,
            '-' => 0x000000007E000000,
            '.' => 0x0000000000181800,
            '/' => 0x303018180C0C0606,
            '0' => 0x3C666E7E76663C00,
            '1' => 0x1818381818187E00,
            '2' => 0x3C66060C18307E00,
            '3' => 0x3C66061C06663C00,
            '4' => 0x060E1E367F060600,
            '5' => 0x7E607C0606663C00,
            '6' => 0x1C30607C66663C00,
            '7' => 0x7E060C1818181800,
            '8' => 0x3C66663C66663C00,
            '9' => 0x3C66663E060C3800,
            ':' => 0x0000180000180000,
            ';' => 0x0000180000180C18,
            '<' => 0x000C1830180C0000,
            '=' => 0x00007E00007E0000,
            '>' => 0x00180C060C180000,
            '?' => 0x3C66060C18001800,
            '@' => 0x3C66766E60663C00,
            'A' => 0x183C66667E666600,
            'B' => 0x7C66667C66667C00,
            'C' => 0x3C66606060663C00,
            'D' => 0x786C6666666C7800,
            'E' => 0x7E60607C60607E00,
            'F' => 0x7E60607C60606000,
            'G' => 0x3C66606E66663C00,
            'H' => 0x6666667E66666600,
            'I' => 0x3C18181818183C00,
            'J' => 0x1E0C0C0C6C6C3800,
            'K' => 0x666C78786C666600,
            'L' => 0x6060606060607E00,
            'M' => 0x63777F6B63636300,
            'N' => 0x66767E7E6E666600,
            'O' => 0x3C66666666663C00,
            'P' => 0x7C66667C60606000,
            'Q' => 0x3C6666666E3C0600,
            'R' => 0x7C66667C6C666600,
            'S' => 0x3C603C06063C00,
            'T' => 0x7E18181818181800,
            'U' => 0x6666666666663C00,
            'V' => 0x66666666663C1800,
            'W' => 0x63636B7F77636300,
            'X' => 0x66663C183C666600,
            'Y' => 0x6666663C18181800,
            'Z' => 0x7E060C1830607E00,
            '[' => 0x3C30303030303C00,
            '\\' => 0x06060C0C18183030,
            ']' => 0x3C0C0C0C0C0C3C00,
            '^' => 0x183C660000000000,
            '_' => 0x0000000000007E00,
            '`' => 0x18180C0000000000,
            'a' => 0x00003C063E663E00,
            'b' => 0x60607C6666667C00,
            'c' => 0x00003C6660603C00,
            'd' => 0x06063E6666663E00,
            'e' => 0x00003C667E603C00,
            'f' => 0x1C30307C30303000,
            'g' => 0x00003E66663E063C,
            'h' => 0x60607C6666666600,
            'i' => 0x1800181818181800,
            'j' => 0x0C000C0C0C6C3800,
            'k' => 0x6060666C786C6600,
            'l' => 0x1818181818181800,
            'm' => 0x0000767F6B636300,
            'n' => 0x00007C6666666600,
            'o' => 0x00003C6666663C00,
            'p' => 0x00007C66667C6060,
            'q' => 0x00003E66663E0606,
            'r' => 0x00007C6660606000,
            's' => 0x00003E603C067C00,
            't' => 0x30307C3030301C00,
            'u' => 0x0000666666663E00,
            'v' => 0x00006666663C1800,
            'w' => 0x0000636B7F360000,
            'x' => 0x0000663C183C6600,
            'y' => 0x00006666663E063C,
            'z' => 0x00007E0C18307E00,
            '{' => 0x0C18187018180C00,
            '|' => 0x1818180018181800,
            '}' => 0x3018180E18183000,
            '~' => 0x0000003E6C000000,
            else => 0x7E8185B581817E00,
        };
    }
};
