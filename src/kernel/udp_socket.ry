//! UDP Socket Management
//! Why: Manage UDP sockets for network communication.

const std = @import("std");
const Debug = @import("debug.zig");
const UdpSocketStats = @import("udp_socket_stats.zig").UdpSocketStats;

const MAX_SOCKETS: u32 = 8;
const MAX_BUFFER: u32 = 4 * 1024;

/// UDP socket state.
/// Why: Track socket state for connection management.
pub const UdpSocketState = enum(u8) { closed = 0, bound = 1 };

/// UDP socket entry.
/// Why: Track UDP socket configuration and state.
pub const UdpSocket = struct {
    socket_id: u64,
    state: UdpSocketState,
    local_addr: u32,
    local_port: u16,
    recv_buffer: [MAX_BUFFER]u8,
    recv_buffer_size: u32,
    send_buffer: [MAX_BUFFER]u8,
    send_buffer_size: u32,
    allocated: bool,
    owner_process_id: u32,

    /// Initialize empty UDP socket entry.
    /// Why: Explicit initialization.
    pub fn init() UdpSocket {
        return UdpSocket{
            .socket_id = 0,
            .state = .closed,
            .local_addr = 0,
            .local_port = 0,
            .recv_buffer = [_]u8{0} ** MAX_BUFFER,
            .recv_buffer_size = 0,
            .send_buffer = [_]u8{0} ** MAX_BUFFER,
            .send_buffer_size = 0,
            .allocated = false,
            .owner_process_id = 0,
        };
    }

    /// Check if socket is valid.
    /// Why: Validate socket state before operations.
    pub fn is_valid(self: *const UdpSocket) bool {
        Debug.kassert(self.allocated, "Socket not allocated", .{});
        return self.state != .closed;
    }
};

/// UDP socket manager.
/// Why: Manage all UDP sockets.
pub const UdpSocketManager = struct {
    sockets: [MAX_SOCKETS]UdpSocket,
    next_socket_id: u64,
    initialized: bool,
    stats: UdpSocketStats,

    /// Initialize UDP socket manager.
    /// Why: Set up manager state.
    pub fn init() UdpSocketManager {
        return UdpSocketManager{
            .sockets = [_]UdpSocket{UdpSocket.init()} ** MAX_SOCKETS,
            .next_socket_id = 1,
            .initialized = true,
            .stats = UdpSocketStats.init(),
        };
    }

    /// Create a new UDP socket.
    /// Why: Allocate a new UDP socket.
    pub fn create_socket(self: *UdpSocketManager, owner: u32) ?u64 {
        Debug.kassert(self.initialized, "Manager not initialized", .{});
        for (&self.sockets) |*s| {
            if (!s.allocated) {
                s.* = UdpSocket.init();
                s.allocated = true;
                s.socket_id = self.next_socket_id;
                s.owner_process_id = owner;
                const id = self.next_socket_id;
                self.next_socket_id = if (self.next_socket_id == 0) 1 else self.next_socket_id + 1;
                return id;
            }
        }
        return null;
    }

    /// Get socket by ID.
    /// Why: Retrieve socket entry.
    pub fn get_socket(self: *UdpSocketManager, id: u64) ?*UdpSocket {
        Debug.kassert(self.initialized, "Manager not initialized", .{});
        if (id == 0) return null;
        for (&self.sockets) |*s| {
            if (s.allocated and s.socket_id == id) return s;
        }
        return null;
    }

    /// Bind socket to local address and port.
    /// Why: Configure local endpoint for socket.
    pub fn bind_socket(self: *UdpSocketManager, id: u64, addr: u32, port: u16) bool {
        Debug.kassert(self.initialized, "Manager not initialized", .{});
        const sock = self.get_socket(id) orelse return false;
        if (sock.state != .closed) return false;
        sock.local_addr = addr;
        sock.local_port = port;
        sock.state = .bound;
        self.stats.record_bound_socket();
        return true;
    }

    /// Send data to remote address and port.
    /// Why: Transmit data to remote endpoint.
    pub fn sendto(self: *UdpSocketManager, id: u64, data: []const u8, addr: u32, port: u16) ?u32 {
        Debug.kassert(self.initialized, "Manager not initialized", .{});
        const sock = self.get_socket(id) orelse {
            self.stats.record_send_error();
            return null;
        };
        if (sock.state != .bound) {
            self.stats.record_send_error();
            return null;
        }
        if (sock.send_buffer_size + data.len > MAX_BUFFER) {
            self.stats.record_send_error();
            return null;
        }
        std.mem.copyForwards(u8, sock.send_buffer[sock.send_buffer_size..], data);
        const n = @as(u32, @truncate(data.len));
        sock.send_buffer_size += n;
        self.stats.record_bytes_sent(n);
        _ = addr;
        _ = port;
        return n;
    }

    /// Receive data from socket.
    /// Why: Read incoming data from bound socket.
    pub fn recvfrom(self: *UdpSocketManager, id: u64, buf: []u8, addr_p: ?*u32, port_p: ?*u16) ?u32 {
        Debug.kassert(self.initialized, "Manager not initialized", .{});
        const sock = self.get_socket(id) orelse {
            self.stats.record_receive_error();
            return null;
        };
        if (sock.state != .bound or buf.len == 0) {
            self.stats.record_receive_error();
            return null;
        }
        const n = @min(sock.recv_buffer_size, @as(u32, @truncate(buf.len)));
        if (n > 0) {
            std.mem.copyForwards(u8, buf, sock.recv_buffer[0..n]);
            std.mem.copyForwards(u8, sock.recv_buffer[0..], sock.recv_buffer[n..sock.recv_buffer_size]);
            sock.recv_buffer_size -= n;
            self.stats.record_bytes_received(n);
        }
        if (addr_p) |a| a.* = 0;
        if (port_p) |p| p.* = 0;
        return n;
    }

    /// Enumerate all UDP sockets.
    /// Why: Get list of all allocated sockets.
    pub fn enumerate_sockets(self: *UdpSocketManager, ids: []u64) u32 {
        Debug.kassert(self.initialized, "Manager not initialized", .{});
        var count: u32 = 0;
        for (&self.sockets) |*s| {
            if (s.allocated and count < ids.len) {
                ids[count] = s.socket_id;
                count += 1;
            }
        }
        return count;
    }

    /// Close socket.
    /// Why: Release socket resources.
    pub fn close_socket(self: *UdpSocketManager, id: u64) bool {
        Debug.kassert(self.initialized, "Manager not initialized", .{});
        const sock = self.get_socket(id) orelse return false;
        sock.state = .closed;
        sock.allocated = false;
        self.stats.record_closed_socket();
        return true;
    }

    /// Get UDP socket statistics snapshot.
    /// Why: Provide statistics for userspace queries.
    pub fn get_stats(self: *const UdpSocketManager) *const UdpSocketStats {
        Debug.kassert(self.initialized, "Manager not initialized", .{});
        return &self.stats;
    }
};
