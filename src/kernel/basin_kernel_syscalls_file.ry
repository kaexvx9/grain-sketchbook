//! Basin Kernel File Syscalls
//! Why: File system syscalls (open, read, write, close, unlink, rename, mkdir, opendir, readdir, closedir).

const std = @import("std");
const Debug = @import("debug.zig");

const types = @import("basin_kernel_types.zig");
const BasinError = types.BasinError;
const SyscallResult = types.SyscallResult;
const OpenFlags = types.OpenFlags;
const DirectoryHandle = types.DirectoryHandle;
const MAX_PROCESSES = types.MAX_PROCESSES;
const MAX_HANDLES = types.MAX_HANDLES;
const MAX_DIR_HANDLES = types.MAX_DIR_HANDLES;

const core = @import("basin_kernel_core.zig");
const BasinKernel = core.BasinKernel;
const can_open_file_descriptor = core.can_open_file_descriptor;

/// File syscall handlers for BasinKernel.
/// Why: Extract file system syscalls to separate module.
pub const FileSyscalls = struct {
    const VM_SIZE: u64 = 4 * 1024 * 1024;

    fn validate_path(ptr: u64, len: u64) ?BasinError {
        if (ptr == 0 or ptr >= VM_SIZE) return BasinError.invalid_argument;
        if (len == 0 or len > 255) return BasinError.invalid_argument;
        if (ptr + len > VM_SIZE) return BasinError.invalid_argument;
        return null;
    }

    fn validate_flags(flags: u64) ?OpenFlags {
        const f = @as(OpenFlags, @bitCast(@as(u32, @truncate(flags))));
        if (f._padding != 0 or (!f.read and !f.write)) return null;
        return f;
    }

    fn alloc_handle(self: *BasinKernel, idx: usize, plen: u64, flags: OpenFlags, owner: u32) u32 {
        var h = &self.handles[idx];
        const id = self.next_handle_id;
        self.next_handle_id += 1;
        h.id = id;
        h.path_len = @as(u32, @intCast(plen));
        h.flags = flags;
        h.position = 0;
        h.buffer_size = 0;
        h.allocated = true;
        h.owner_process_id = owner;
        self.update_handle_hash_table(id, idx);
        if (flags.truncate) h.buffer_size = 0;
        return id;
    }

    /// Why: Open a file, return handle ID.
    pub fn syscall_open(self: *BasinKernel, ptr: u64, len: u64, flags: u64, _: u64) BasinError!SyscallResult {
        if (validate_path(ptr, len)) |err| return SyscallResult.fail(err);
        const f = validate_flags(flags) orelse return SyscallResult.fail(BasinError.invalid_argument);
        const idx = self.find_free_handle() orelse return SyscallResult.fail(BasinError.out_of_memory);
        const pidx = self.find_current_process_index();
        const owner = if (pidx) |i| @as(u32, @truncate(self.processes[i].id)) else 0;
        if (pidx) |i| {
            if (!self.can_open_file_descriptor(&self.processes[i])) {
                return SyscallResult.fail(BasinError.resource_exhausted);
            }
        }
        const id = alloc_handle(self, idx, len, f, owner);
        if (pidx) |i| self.processes[i].open_file_descriptors += 1;
        return SyscallResult.ok(id);
    }

    fn validate_buf(h: u64, ptr: u64, len: u64) ?SyscallResult {
        if (h == 0 or ptr == 0 or ptr >= VM_SIZE) return SyscallResult.fail(BasinError.invalid_argument);
        if (len == 0 or len > 1024 * 1024 or ptr + len > VM_SIZE) return SyscallResult.fail(BasinError.invalid_argument);
        return null;
    }

    /// Why: Read data from an open file handle.
    pub fn syscall_read(self: *BasinKernel, h: u64, ptr: u64, len: u64, timeout: u64) BasinError!SyscallResult {
        if (validate_buf(h, ptr, len)) |err| return err;
        const start = self.timer.get_monotonic_ns();
        const idx = self.find_handle_by_id(h) orelse return SyscallResult.fail(BasinError.invalid_handle);
        var fh = &self.handles[idx];
        if (!fh.flags.read) return SyscallResult.fail(BasinError.permission_denied);
        if (self.check_timeout(start, timeout)) return SyscallResult.fail(BasinError.file_io_timeout);
        const avail = if (fh.position < fh.buffer_size) fh.buffer_size - fh.position else 0;
        const n = @min(avail, @as(u32, @intCast(len)));
        fh.position += n;
        return SyscallResult.ok(@as(u64, n));
    }

    /// Why: Write data to an open file handle.
    pub fn syscall_write(self: *BasinKernel, h: u64, ptr: u64, len: u64, timeout: u64) BasinError!SyscallResult {
        if (validate_buf(h, ptr, len)) |err| return err;
        const start = self.timer.get_monotonic_ns();
        const idx = self.find_handle_by_id(h) orelse return SyscallResult.fail(BasinError.invalid_handle);
        var fh = &self.handles[idx];
        if (!fh.flags.write) return SyscallResult.fail(BasinError.permission_denied);
        if (self.check_timeout(start, timeout)) return SyscallResult.fail(BasinError.file_io_timeout);
        const max = fh.buffer.len;
        const avail = if (fh.position < max) @as(u32, @intCast(max - fh.position)) else 0;
        const n = @min(@as(u32, @intCast(len)), avail);
        fh.position += n;
        if (fh.position > fh.buffer_size) fh.buffer_size = @as(u32, @intCast(fh.position));
        return SyscallResult.ok(@as(u64, n));
    }

    fn dealloc_handle(self: *BasinKernel, idx: usize) void {
        var fh = &self.handles[idx];
        const owner = fh.owner_process_id;
        const id = fh.id;
        self.invalidate_handle_hash_table(id);
        fh.allocated = false;
        fh.id = 0;
        fh.path_len = 0;
        fh.position = 0;
        fh.buffer_size = 0;
        fh.owner_process_id = 0;
        if (self.mru_handle_id == id) self.invalidate_mru_handle_cache();
        if (owner > 0) {
            for (0..MAX_PROCESSES) |i| {
                if (self.processes[i].allocated and self.processes[i].id == owner) {
                    if (self.processes[i].open_file_descriptors > 0) self.processes[i].open_file_descriptors -= 1;
                    break;
                }
            }
        }
    }

    /// Why: Close an open file handle.
    pub fn syscall_close(self: *BasinKernel, h: u64, _: u64, _: u64, _: u64) BasinError!SyscallResult {
        if (h == 0) return SyscallResult.fail(BasinError.invalid_argument);
        const idx = self.find_handle_by_id(h) orelse return SyscallResult.fail(BasinError.invalid_handle);
        dealloc_handle(self, idx);
        return SyscallResult.ok(0);
    }

    /// Why: Delete a file from the filesystem.
    pub fn syscall_unlink(self: *BasinKernel, ptr: u64, len: u64, _: u64, _: u64) BasinError!SyscallResult {
        if (validate_path(ptr, len)) |err| return SyscallResult.fail(err);
        for (0..MAX_HANDLES) |i| {
            if (self.handles[i].allocated and self.handles[i].path_len == @as(u32, @intCast(len))) {
                self.handles[i].allocated = false;
                self.handles[i].id = 0;
                return SyscallResult.ok(0);
            }
        }
        return SyscallResult.fail(BasinError.not_found);
    }

    /// Why: Rename or move a file.
    pub fn syscall_rename(self: *BasinKernel, old_ptr: u64, old_len: u64, new_ptr: u64, new_len: u64) BasinError!SyscallResult {
        if (validate_path(old_ptr, old_len)) |err| return SyscallResult.fail(err);
        if (validate_path(new_ptr, new_len)) |err| return SyscallResult.fail(err);
        for (0..MAX_HANDLES) |i| {
            if (self.handles[i].allocated and self.handles[i].path_len == @as(u32, @intCast(old_len))) {
                self.handles[i].path_len = @as(u32, @intCast(new_len));
                return SyscallResult.ok(0);
            }
        }
        return SyscallResult.fail(BasinError.not_found);
    }

    /// Why: Create a new directory.
    pub fn syscall_mkdir(self: *BasinKernel, ptr: u64, len: u64, _: u64, _: u64) BasinError!SyscallResult {
        if (validate_path(ptr, len)) |err| return SyscallResult.fail(err);
        for (0..MAX_HANDLES) |i| {
            if (self.handles[i].allocated and self.handles[i].path_len == @as(u32, @intCast(len))) {
                return SyscallResult.fail(BasinError.invalid_argument);
            }
        }
        return SyscallResult.ok(0);
    }

    /// Why: Open a directory for reading entries.
    pub fn syscall_opendir(self: *BasinKernel, ptr: u64, len: u64, _: u64, _: u64) BasinError!SyscallResult {
        if (ptr == 0 or ptr >= VM_SIZE) return SyscallResult.fail(BasinError.invalid_argument);
        if (len == 0 or len > 256) return SyscallResult.fail(BasinError.invalid_argument);
        var slot: ?usize = null;
        for (0..MAX_DIR_HANDLES) |i| {
            if (!self.dir_handles[i].allocated) {
                slot = i;
                break;
            }
        }
        const idx = slot orelse return SyscallResult.fail(BasinError.out_of_memory);
        const id = self.next_dir_handle_id;
        self.next_dir_handle_id += 1;
        self.dir_handles[idx].id = id;
        self.dir_handles[idx].path_len = @as(u32, @intCast(len));
        self.dir_handles[idx].position = 0;
        self.dir_handles[idx].allocated = true;
        return SyscallResult.ok(id);
    }

    /// Why: Read the next entry from an open directory.
    pub fn syscall_readdir(self: *BasinKernel, dh: u64, ptr: u64, len: u64, _: u64) BasinError!SyscallResult {
        if (dh == 0 or ptr == 0 or ptr >= VM_SIZE) return SyscallResult.fail(BasinError.invalid_argument);
        if (len == 0 or len > 256) return SyscallResult.fail(BasinError.invalid_argument);
        var found: ?usize = null;
        for (0..MAX_DIR_HANDLES) |i| {
            if (self.dir_handles[i].allocated and self.dir_handles[i].id == dh) {
                found = i;
                break;
            }
        }
        const idx = found orelse return SyscallResult.fail(BasinError.invalid_argument);
        if (self.dir_handles[idx].position > 0) return SyscallResult.ok(0);
        self.dir_handles[idx].position += 1;
        return SyscallResult.ok(1);
    }

    /// Why: Close an open directory handle.
    pub fn syscall_closedir(self: *BasinKernel, dh: u64, _: u64, _: u64, _: u64) BasinError!SyscallResult {
        if (dh == 0) return SyscallResult.fail(BasinError.invalid_argument);
        for (0..MAX_DIR_HANDLES) |i| {
            if (self.dir_handles[i].allocated and self.dir_handles[i].id == dh) {
                self.dir_handles[i] = DirectoryHandle.init();
                return SyscallResult.ok(0);
            }
        }
        return SyscallResult.fail(BasinError.invalid_argument);
    }
};
