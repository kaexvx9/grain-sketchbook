//! Unified Exception Types
//! Why: Abstract exception types for RISC-V and AArch64 kernels.

const std = @import("std");
const Debug = @import("debug.zig");
const platform = @import("platform.zig");

/// Unified exception type (architecture-agnostic).
/// Why: Abstract exception types across RISC-V and AArch64.
pub const ExceptionType = enum(u32) {
    instruction_address_misaligned = 0,
    instruction_access_fault = 1,
    illegal_instruction = 2,
    breakpoint = 3,
    load_address_misaligned = 4,
    load_access_fault = 5,
    store_address_misaligned = 6,
    store_access_fault = 7,
    environment_call_from_u_mode = 8,
    environment_call_from_s_mode = 9,
    instruction_page_fault = 12,
    load_page_fault = 13,
    store_page_fault = 15,
};

/// RISC-V exception code to unified exception type.
/// Why: Map RISC-V-specific exception codes to unified types.
pub fn riscv_to_unified(riscv_code: u32) ExceptionType {
    return switch (riscv_code) {
        0 => .instruction_address_misaligned,
        1 => .instruction_access_fault,
        2 => .illegal_instruction,
        3 => .breakpoint,
        4 => .load_address_misaligned,
        5 => .load_access_fault,
        6 => .store_address_misaligned,
        7 => .store_access_fault,
        8 => .environment_call_from_u_mode,
        9 => .environment_call_from_s_mode,
        12 => .instruction_page_fault,
        13 => .load_page_fault,
        15 => .store_page_fault,
        else => .illegal_instruction,
    };
}

/// Unified exception type to RISC-V exception code.
/// Why: Map unified types to RISC-V-specific exception codes.
pub fn unified_to_riscv(exception_type: ExceptionType) u32 {
    return switch (exception_type) {
        .instruction_address_misaligned => 0,
        .instruction_access_fault => 1,
        .illegal_instruction => 2,
        .breakpoint => 3,
        .load_address_misaligned => 4,
        .load_access_fault => 5,
        .store_address_misaligned => 6,
        .store_access_fault => 7,
        .environment_call_from_u_mode => 8,
        .environment_call_from_s_mode => 9,
        .instruction_page_fault => 12,
        .load_page_fault => 13,
        .store_page_fault => 15,
    };
}

/// AArch64 exception code to unified exception type.
/// Why: Map AArch64 ESR_ELx exception codes to unified types.
pub fn aarch64_to_unified(aarch64_code: u32) ExceptionType {
    const ec = (aarch64_code >> 26) & 0x3F;
    return switch (ec) {
        0x15 => .environment_call_from_u_mode,
        0x20, 0x21 => .instruction_page_fault,
        0x24, 0x25 => if ((aarch64_code & (1 << 6)) != 0) .store_page_fault else .load_page_fault,
        0x30 => .breakpoint,
        0x3C => .illegal_instruction,
        else => .illegal_instruction,
    };
}

/// Unified exception type to AArch64 exception code.
/// Why: Map unified types to AArch64 ESR_ELx format.
pub fn unified_to_aarch64(exception_type: ExceptionType) u32 {
    const ec: u32 = switch (exception_type) {
        .environment_call_from_u_mode, .environment_call_from_s_mode => 0x15,
        .instruction_page_fault, .instruction_access_fault, .instruction_address_misaligned => 0x21,
        .load_page_fault, .load_access_fault, .load_address_misaligned => 0x25,
        .store_page_fault, .store_access_fault, .store_address_misaligned => 0x25 | (1 << 6),
        .breakpoint => 0x30,
        .illegal_instruction => 0x3C,
    };
    return ec << 26;
}

/// Convert architecture-specific exception code to unified type.
/// Why: Platform-agnostic exception code conversion.
pub fn arch_to_unified(arch: platform.PlatformArch, code: u32) ExceptionType {
    return switch (arch) {
        .riscv64 => riscv_to_unified(code),
        .aarch64 => aarch64_to_unified(code),
    };
}

/// Convert unified exception type to architecture-specific code.
/// Why: Platform-agnostic exception code conversion.
pub fn unified_to_arch(arch: platform.PlatformArch, exc: ExceptionType) u32 {
    return switch (arch) {
        .riscv64 => unified_to_riscv(exc),
        .aarch64 => unified_to_aarch64(exc),
    };
}
