//! TCP Socket Management
//! Why: Manage TCP sockets for network communication.

const std = @import("std");
const Debug = @import("debug.zig");
const TcpSocketStats = @import("tcp_socket_stats.zig").TcpSocketStats;

const MAX_SOCKETS: u32 = 8;
const MAX_BUFFER: u32 = 4 * 1024;

/// TCP socket state.
/// Why: Track socket state for connection management.
pub const TcpSocketState = enum(u8) { closed = 0, listening = 1, connecting = 2, connected = 3, closing = 4 };

/// TCP socket entry.
/// Why: Track TCP socket configuration and state.
pub const TcpSocket = struct {
    socket_id: u64,
    state: TcpSocketState,
    local_addr: u32,
    local_port: u16,
    remote_addr: u32,
    remote_port: u16,
    recv_buffer: [MAX_BUFFER]u8,
    recv_buffer_size: u32,
    send_buffer: [MAX_BUFFER]u8,
    send_buffer_size: u32,
    allocated: bool,
    owner_process_id: u32,

    /// Initialize empty TCP socket entry.
    /// Why: Explicit initialization.
    pub fn init() TcpSocket {
        return TcpSocket{
            .socket_id = 0,
            .state = .closed,
            .local_addr = 0,
            .local_port = 0,
            .remote_addr = 0,
            .remote_port = 0,
            .recv_buffer = [_]u8{0} ** MAX_BUFFER,
            .recv_buffer_size = 0,
            .send_buffer = [_]u8{0} ** MAX_BUFFER,
            .send_buffer_size = 0,
            .allocated = false,
            .owner_process_id = 0,
        };
    }

    /// Check if socket is valid.
    /// Why: Validate socket state before operations.
    pub fn is_valid(self: *const TcpSocket) bool {
        Debug.kassert(self.allocated, "Socket not allocated", .{});
        return self.state != .closed;
    }
};

/// TCP socket manager.
/// Why: Manage all TCP sockets.
pub const TcpSocketManager = struct {
    sockets: [MAX_SOCKETS]TcpSocket,
    next_socket_id: u64,
    initialized: bool,
    stats: TcpSocketStats,

    /// Initialize TCP socket manager.
    /// Why: Set up manager state.
    pub fn init() TcpSocketManager {
        return TcpSocketManager{
            .sockets = [_]TcpSocket{TcpSocket.init()} ** MAX_SOCKETS,
            .next_socket_id = 1,
            .initialized = true,
            .stats = TcpSocketStats.init(),
        };
    }

    /// Create a new TCP socket.
    /// Why: Allocate a new TCP socket.
    pub fn create_socket(self: *TcpSocketManager, owner: u32) ?u64 {
        Debug.kassert(self.initialized, "Manager not initialized", .{});
        for (&self.sockets) |*s| {
            if (!s.allocated) {
                s.* = TcpSocket.init();
                s.allocated = true;
                s.socket_id = self.next_socket_id;
                s.owner_process_id = owner;
                const id = self.next_socket_id;
                self.next_socket_id = if (self.next_socket_id == 0) 1 else self.next_socket_id + 1;
                return id;
            }
        }
        return null;
    }

    /// Get socket by ID.
    /// Why: Retrieve socket entry.
    pub fn get_socket(self: *TcpSocketManager, id: u64) ?*TcpSocket {
        Debug.kassert(self.initialized, "Manager not initialized", .{});
        if (id == 0) return null;
        for (&self.sockets) |*s| {
            if (s.allocated and s.socket_id == id) return s;
        }
        return null;
    }

    /// Bind socket to local address and port.
    /// Why: Configure local endpoint for socket.
    pub fn bind_socket(self: *TcpSocketManager, id: u64, addr: u32, port: u16) bool {
        Debug.kassert(self.initialized, "Manager not initialized", .{});
        const sock = self.get_socket(id) orelse return false;
        if (sock.state != .closed) return false;
        sock.local_addr = addr;
        sock.local_port = port;
        return true;
    }

    /// Set socket to listening state.
    /// Why: Enable socket to accept incoming connections.
    pub fn listen_socket(self: *TcpSocketManager, id: u64) bool {
        Debug.kassert(self.initialized, "Manager not initialized", .{});
        const sock = self.get_socket(id) orelse return false;
        if (sock.local_addr == 0 or sock.local_port == 0 or sock.state != .closed) return false;
        sock.state = .listening;
        self.stats.record_listening_transition();
        return true;
    }

    /// Accept incoming connection.
    /// Why: Accept incoming connection on listening socket.
    pub fn accept_connection(self: *TcpSocketManager, id: u64, owner: u32) ?u64 {
        Debug.kassert(self.initialized, "Manager not initialized", .{});
        const sock = self.get_socket(id) orelse return null;
        if (sock.state != .listening) return null;

        const new_id = self.create_socket(owner) orelse return null;
        const new_sock = self.get_socket(new_id).?;
        new_sock.state = .connected;
        new_sock.local_addr = sock.local_addr;
        new_sock.local_port = sock.local_port;
        self.stats.record_connected_transition();
        self.stats.record_established_connection();
        self.stats.record_active_connection();
        return new_id;
    }

    /// Connect socket to remote address and port.
    /// Why: Establish connection to remote endpoint.
    pub fn connect_socket(self: *TcpSocketManager, id: u64, addr: u32, port: u16) bool {
        Debug.kassert(self.initialized, "Manager not initialized", .{});
        const sock = self.get_socket(id) orelse {
            self.stats.record_connection_error();
            return false;
        };
        if (sock.state != .closed) {
            self.stats.record_connection_error();
            return false;
        }
        sock.remote_addr = addr;
        sock.remote_port = port;
        sock.state = .connecting;
        self.stats.record_connecting_transition();
        sock.state = .connected;
        self.stats.record_connected_transition();
        self.stats.record_established_connection();
        self.stats.record_active_connection();
        return true;
    }

    /// Send data on socket.
    /// Why: Transmit data on connected socket.
    pub fn send_data(self: *TcpSocketManager, id: u64, data: []const u8) ?u32 {
        Debug.kassert(self.initialized, "Manager not initialized", .{});
        const sock = self.get_socket(id) orelse {
            self.stats.record_send_error();
            return null;
        };
        if (sock.state != .connected) {
            self.stats.record_send_error();
            return null;
        }
        if (sock.send_buffer_size + data.len > MAX_BUFFER) {
            self.stats.record_send_error();
            return null;
        }
        std.mem.copyForwards(u8, sock.send_buffer[sock.send_buffer_size..], data);
        const n = @as(u32, @truncate(data.len));
        sock.send_buffer_size += n;
        self.stats.record_bytes_sent(n);
        return n;
    }

    /// Receive data from socket.
    /// Why: Read incoming data from connected socket.
    pub fn recv_data(self: *TcpSocketManager, id: u64, buf: []u8) ?u32 {
        Debug.kassert(self.initialized, "Manager not initialized", .{});
        const sock = self.get_socket(id) orelse {
            self.stats.record_receive_error();
            return null;
        };
        if (sock.state != .connected or buf.len == 0) {
            self.stats.record_receive_error();
            return null;
        }
        const n = @min(sock.recv_buffer_size, @as(u32, @truncate(buf.len)));
        if (n > 0) {
            std.mem.copyForwards(u8, buf, sock.recv_buffer[0..n]);
            std.mem.copyForwards(u8, sock.recv_buffer[0..], sock.recv_buffer[n..sock.recv_buffer_size]);
            sock.recv_buffer_size -= n;
            self.stats.record_bytes_received(n);
        }
        return n;
    }

    /// Enumerate all TCP sockets.
    /// Why: Get list of all allocated sockets.
    pub fn enumerate_sockets(self: *TcpSocketManager, ids: []u64) u32 {
        Debug.kassert(self.initialized, "Manager not initialized", .{});
        var count: u32 = 0;
        for (&self.sockets) |*s| {
            if (s.allocated and count < ids.len) {
                ids[count] = s.socket_id;
                count += 1;
            }
        }
        return count;
    }

    /// Close socket.
    /// Why: Release socket resources.
    pub fn close_socket(self: *TcpSocketManager, id: u64) bool {
        Debug.kassert(self.initialized, "Manager not initialized", .{});
        const sock = self.get_socket(id) orelse return false;
        sock.state = .closed;
        sock.allocated = false;
        return true;
    }

    /// Get TCP socket statistics snapshot.
    /// Why: Provide statistics for userspace queries.
    pub fn get_stats(self: *const TcpSocketManager) *const TcpSocketStats {
        Debug.kassert(self.initialized, "Manager not initialized", .{});
        return &self.stats;
    }
};
