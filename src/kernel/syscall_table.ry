//! Syscall table for kernel help and introspection.
//! Why: Provide syscall descriptions for debugging and documentation.

const std = @import("std");

/// Syscall descriptor.
/// Why: Map syscall numbers to names and descriptions.
pub const Syscall = struct {
    number: u16,
    name: []const u8,
    description: []const u8,
};

/// Syscall table with descriptions.
/// Why: Centralized registry for help output.
pub const table = [_]Syscall{
    .{ .number = 0, .name = "debug_write", .description = "Write to debug console." },
    .{ .number = 1, .name = "exit", .description = "Terminate task with status." },
};

/// Look up syscall description by number.
/// Why: Enable help output and introspection.
pub fn describe(number: u16) ?Syscall {
    for (table) |entry| {
        if (entry.number == number) return entry;
    }
    return null;
}
