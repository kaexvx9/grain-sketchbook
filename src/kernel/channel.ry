//! Grain Basin IPC Channel
//! Why: Inter-process communication via message queues.

const std = @import("std");
const Debug = @import("debug.zig");

pub const MAX_MESSAGE_SIZE: u32 = 512;
pub const MAX_MESSAGES: u32 = 8;
const MAX_CHANNELS: u32 = 8;

/// Channel message.
/// Why: Store message data in channel queue.
pub const Message = struct {
    data: [MAX_MESSAGE_SIZE]u8,
    length: u32,
    valid: bool,

    /// Initialize empty message.
    /// Why: Explicit initialization.
    pub fn init() Message {
        return Message{ .data = [_]u8{0} ** MAX_MESSAGE_SIZE, .length = 0, .valid = false };
    }
};

/// IPC channel for inter-process communication.
/// Why: Enable processes to send/receive messages.
pub const Channel = struct {
    id: u64,
    messages: [MAX_MESSAGES]Message,
    message_count: u32,
    read_pos: u32,
    write_pos: u32,
    allocated: bool,
    owner_process_id: u32,

    /// Initialize empty channel.
    /// Why: Explicit initialization.
    pub fn init() Channel {
        return Channel{
            .id = 0,
            .messages = [_]Message{Message.init()} ** MAX_MESSAGES,
            .message_count = 0,
            .read_pos = 0,
            .write_pos = 0,
            .allocated = false,
            .owner_process_id = 0,
        };
    }

    /// Send message to channel.
    /// Why: Add message to channel queue.
    pub fn send(self: *Channel, data: []const u8) bool {
        Debug.kassert(self.allocated, "Channel not allocated", .{});
        Debug.kassert(data.len <= MAX_MESSAGE_SIZE and data.len > 0, "Invalid data", .{});
        if (self.message_count >= MAX_MESSAGES) return false;

        var msg = &self.messages[self.write_pos];
        @memcpy(msg.data[0..data.len], data);
        msg.length = @as(u32, @intCast(data.len));
        msg.valid = true;
        self.write_pos = (self.write_pos + 1) % MAX_MESSAGES;
        self.message_count += 1;
        return true;
    }

    /// Receive message from channel.
    /// Why: Remove message from channel queue.
    pub fn receive(self: *Channel, buffer: []u8) u32 {
        Debug.kassert(self.allocated, "Channel not allocated", .{});
        Debug.kassert(buffer.len >= MAX_MESSAGE_SIZE, "Buffer too small", .{});
        if (self.message_count == 0) return 0;

        var msg = &self.messages[self.read_pos];
        Debug.kassert(msg.valid, "Message not valid", .{});
        const n = @min(msg.length, @as(u32, @intCast(buffer.len)));
        @memcpy(buffer[0..n], msg.data[0..n]);
        msg.valid = false;
        msg.length = 0;
        self.read_pos = (self.read_pos + 1) % MAX_MESSAGES;
        self.message_count -= 1;
        return n;
    }

    /// Check if channel has messages.
    /// Why: Query channel state without blocking.
    pub fn has_messages(self: *const Channel) bool {
        Debug.kassert(self.allocated, "Channel not allocated", .{});
        return self.message_count > 0;
    }

    /// Get message count.
    /// Why: Query number of messages in queue.
    pub fn get_message_count(self: *const Channel) u32 {
        Debug.kassert(self.allocated, "Channel not allocated", .{});
        return self.message_count;
    }
};

/// Channel table for kernel.
/// Why: Manage all IPC channels in kernel.
pub const ChannelTable = struct {
    channels: [MAX_CHANNELS]Channel,
    channel_count: u32,
    next_channel_id: u64,

    /// Initialize channel table.
    /// Why: Set up channel table state.
    pub fn init() ChannelTable {
        return ChannelTable{
            .channels = [_]Channel{Channel.init()} ** MAX_CHANNELS,
            .channel_count = 0,
            .next_channel_id = 1,
        };
    }

    /// Create new channel.
    /// Why: Allocate channel for IPC.
    pub fn create(self: *ChannelTable) u64 {
        for (&self.channels) |*ch| {
            if (!ch.allocated) {
                const id = self.next_channel_id;
                self.next_channel_id += 1;
                ch.id = id;
                ch.allocated = true;
                ch.message_count = 0;
                ch.read_pos = 0;
                ch.write_pos = 0;
                ch.owner_process_id = 0;
                self.channel_count += 1;
                return id;
            }
        }
        return 0;
    }

    /// Find channel by ID.
    /// Why: Look up channel for send/receive operations.
    pub fn find(self: *ChannelTable, id: u64) ?*Channel {
        Debug.kassert(id != 0, "Channel ID is 0", .{});
        for (&self.channels) |*ch| {
            if (ch.allocated and ch.id == id) return ch;
        }
        return null;
    }

    /// Get channel count.
    /// Why: Query number of allocated channels.
    pub fn get_count(self: *const ChannelTable) u32 {
        return self.channel_count;
    }
};

test "channel init" {
    const ch = Channel.init();
    try std.testing.expect(!ch.allocated);
    try std.testing.expect(ch.message_count == 0);
}

test "channel send receive" {
    var ch = Channel.init();
    ch.allocated = true;
    ch.id = 1;
    const sent = ch.send("Hello");
    try std.testing.expect(sent);
    try std.testing.expect(ch.message_count == 1);
    var buf: [MAX_MESSAGE_SIZE]u8 = undefined;
    const n = ch.receive(&buf);
    try std.testing.expect(n == 5);
    try std.testing.expect(ch.message_count == 0);
}

test "channel table create" {
    var t = ChannelTable.init();
    const id = t.create();
    try std.testing.expect(id != 0);
    try std.testing.expect(t.channel_count == 1);
}
