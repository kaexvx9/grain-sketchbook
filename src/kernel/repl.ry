//! Simple REPL for Kernel Interactive Mode
//! Why: Provide interactive command interface for development and testing.

const RawIO = @import("uart.zig");
const BasinKernel = @import("basin_kernel.zig").BasinKernel;

/// Minimal UART output - comptime unrolled, inline asm only.
/// Why: Zig's RISC-V freestanding codegen has issues with runtime loops.
const Uart = struct {
    inline fn putc(c: u8) void {
        asm volatile (
            \\lui t1, 0x10000
            \\sb %[byte], 0(t1)
            :
            : [byte] "r" (c),
        );
    }

    pub inline fn print(comptime s: []const u8) void {
        inline for (s) |c| {
            putc(c);
        }
    }
};

/// Simple REPL for kernel interactive mode.
/// Why: Interactive Grainscript shell.
pub const Repl = struct {
    kernel: *BasinKernel,
    running: bool,

    const Self = @This();
    const MAX_LINE_LEN: u32 = 256;

    /// Initialize REPL.
    /// Why: Set up REPL state with kernel reference.
    pub fn init(kernel: *BasinKernel) Self {
        return Self{ .kernel = kernel, .running = true };
    }

    /// Run REPL loop.
    /// Why: Main interactive loop for Grainscript shell.
    pub fn run(self: *Self) void {
        Uart.print("\n");
        Uart.print("Grainscript REPL v0.1.0\n");
        Uart.print("Type 'help' for commands, 'exit' to quit.\n");
        Uart.print("\n");

        var line_buf: [MAX_LINE_LEN]u8 = undefined;
        var line_len: u32 = 0;

        while (self.running) {
            Uart.print("grainscript> ");
            line_len = 0;
            while (line_len < MAX_LINE_LEN) {
                const c = RawIO.read_byte_blocking();
                if (c == '\n' or c == '\r') break;
                if (c == '\x08' or c == '\x7f') {
                    if (line_len > 0) {
                        line_len -= 1;
                        Uart.print("\x08 \x08");
                    }
                    continue;
                }
                if (c >= 0x20 and c < 0x7f) {
                    line_buf[line_len] = c;
                    line_len += 1;
                    RawIO.write_byte(c);
                }
            }
            Uart.print("\n");
            if (line_len > 0) self.process_line(line_buf[0..line_len]);
        }
    }

    /// Process a line of input.
    /// Why: Dispatch commands or echo unknown input.
    fn process_line(self: *Self, line: []const u8) void {
        if (starts_with(line, "exit")) {
            Uart.print("Goodbye!\n");
            self.running = false;
            return;
        }
        if (starts_with(line, "help")) {
            Uart.print("Commands: help, exit, sysinfo\n");
            return;
        }
        if (starts_with(line, "sys")) {
            Uart.print("Basin Kernel v0.1.0 (RISC-V64)\n");
            Uart.print("Users: ");
            const count = self.kernel.user_count;
            if (count < 10) {
                Uart.putc('0' + @as(u8, @intCast(count)));
            } else {
                Uart.print("10+");
            }
            Uart.print("\n");
            return;
        }
        Uart.print("Unknown: ");
        for (line) |c| RawIO.write_byte(c);
        Uart.print("\n");
    }

    fn starts_with(line: []const u8, prefix: []const u8) bool {
        if (line.len < prefix.len) return false;
        for (prefix, 0..) |c, i| {
            if (line[i] != c) return false;
        }
        return true;
    }
};
