//! Network Interface Management
//! Why: Manage network interfaces for TCP/UDP syscalls.

const std = @import("std");
const Debug = @import("debug.zig");
const NetworkInterfaceStats = @import("network_interface_stats.zig").NetworkInterfaceStats;

const MAX_IFACES: u32 = 8;
const MAX_NAME_LEN: u32 = 16;

/// Network interface state.
/// Why: Track interface state (up/down).
pub const InterfaceState = enum(u8) { down = 0, up = 1 };

/// Network interface entry.
/// Why: Track network interface configuration and state.
pub const NetworkInterface = struct {
    name: [MAX_NAME_LEN]u8,
    state: InterfaceState,
    ipv4_addr: u32,
    ipv4_netmask: u32,
    ipv4_gateway: u32,
    ipv6_addr: [16]u8,
    allocated: bool,

    /// Initialize empty network interface entry.
    /// Why: Explicit initialization.
    pub fn init() NetworkInterface {
        return NetworkInterface{
            .name = [_]u8{0} ** MAX_NAME_LEN,
            .state = .down,
            .ipv4_addr = 0,
            .ipv4_netmask = 0,
            .ipv4_gateway = 0,
            .ipv6_addr = [_]u8{0} ** 16,
            .allocated = false,
        };
    }

    /// Set interface name.
    /// Why: Configure interface name.
    pub fn set_name(self: *NetworkInterface, name: []const u8) bool {
        Debug.kassert(self.allocated, "Entry not allocated", .{});
        if (name.len == 0 or name.len >= MAX_NAME_LEN) return false;
        @memset(&self.name, 0);
        @memcpy(self.name[0..name.len], name);
        return true;
    }

    /// Get interface name.
    /// Why: Retrieve interface name.
    pub fn get_name(self: *const NetworkInterface) []const u8 {
        Debug.kassert(self.allocated, "Entry not allocated", .{});
        var len: u32 = 0;
        while (len < MAX_NAME_LEN and self.name[len] != 0) len += 1;
        return self.name[0..len];
    }
};

/// Network interface manager.
/// Why: Manage all network interfaces.
pub const NetworkInterfaceManager = struct {
    interfaces: [MAX_IFACES]NetworkInterface,
    initialized: bool,
    stats: NetworkInterfaceStats,

    /// Initialize network interface manager.
    /// Why: Set up manager state.
    pub fn init() NetworkInterfaceManager {
        return NetworkInterfaceManager{
            .interfaces = [_]NetworkInterface{NetworkInterface.init()} ** MAX_IFACES,
            .initialized = true,
            .stats = NetworkInterfaceStats.init(),
        };
    }

    /// Create a new network interface.
    /// Why: Add a new network interface.
    pub fn create_interface(self: *NetworkInterfaceManager, name: []const u8) ?u32 {
        Debug.kassert(self.initialized, "Manager not initialized", .{});
        if (name.len == 0 or name.len >= MAX_NAME_LEN) {
            self.stats.record_creation_error();
            return null;
        }
        for (&self.interfaces, 0..) |*iface, i| {
            if (!iface.allocated) {
                iface.* = NetworkInterface.init();
                iface.allocated = true;
                if (!iface.set_name(name)) {
                    iface.allocated = false;
                    self.stats.record_creation_error();
                    return null;
                }
                self.stats.record_interface_created();
                return @as(u32, @intCast(i));
            }
        }
        self.stats.record_creation_error();
        return null;
    }

    /// Get interface by index.
    /// Why: Retrieve interface entry.
    pub fn get_interface(self: *NetworkInterfaceManager, idx: u32) ?*NetworkInterface {
        Debug.kassert(self.initialized, "Manager not initialized", .{});
        if (idx >= MAX_IFACES or !self.interfaces[idx].allocated) return null;
        return &self.interfaces[idx];
    }

    /// Find interface by name.
    /// Why: Look up interface by name.
    pub fn find_interface_by_name(self: *const NetworkInterfaceManager, name: []const u8) ?u32 {
        Debug.kassert(self.initialized, "Manager not initialized", .{});
        if (name.len == 0) return null;
        for (&self.interfaces, 0..) |*iface, i| {
            if (iface.allocated and std.mem.eql(u8, iface.get_name(), name)) {
                return @as(u32, @intCast(i));
            }
        }
        return null;
    }

    /// Set interface state (up/down).
    /// Why: Control interface state.
    pub fn set_interface_state(self: *NetworkInterfaceManager, idx: u32, state: InterfaceState) bool {
        Debug.kassert(self.initialized, "Manager not initialized", .{});
        const iface = self.get_interface(idx) orelse {
            self.stats.record_configuration_error();
            return false;
        };
        const old = iface.state;
        iface.state = state;
        if (old != state) {
            if (state == .up) self.stats.record_up_transition() else self.stats.record_down_transition();
        }
        return true;
    }

    /// Set IPv4 address.
    /// Why: Configure IPv4 address.
    pub fn set_ipv4_address(self: *NetworkInterfaceManager, idx: u32, addr: u32) bool {
        Debug.kassert(self.initialized, "Manager not initialized", .{});
        const iface = self.get_interface(idx) orelse {
            self.stats.record_configuration_error();
            return false;
        };
        iface.ipv4_addr = addr;
        self.stats.record_ipv4_configuration();
        return true;
    }

    /// Set IPv4 netmask.
    /// Why: Configure IPv4 netmask.
    pub fn set_ipv4_netmask(self: *NetworkInterfaceManager, idx: u32, netmask: u32) bool {
        Debug.kassert(self.initialized, "Manager not initialized", .{});
        const iface = self.get_interface(idx) orelse return false;
        iface.ipv4_netmask = netmask;
        return true;
    }

    /// Set IPv4 gateway.
    /// Why: Configure IPv4 gateway.
    pub fn set_ipv4_gateway(self: *NetworkInterfaceManager, idx: u32, gateway: u32) bool {
        Debug.kassert(self.initialized, "Manager not initialized", .{});
        const iface = self.get_interface(idx) orelse return false;
        iface.ipv4_gateway = gateway;
        return true;
    }

    /// Set IPv6 address.
    /// Why: Configure IPv6 address.
    pub fn set_ipv6_address(self: *NetworkInterfaceManager, idx: u32, addr: [16]u8) bool {
        Debug.kassert(self.initialized, "Manager not initialized", .{});
        const iface = self.get_interface(idx) orelse {
            self.stats.record_configuration_error();
            return false;
        };
        @memcpy(&iface.ipv6_addr, &addr);
        self.stats.record_ipv6_configuration();
        return true;
    }

    /// Enumerate all network interfaces.
    /// Why: Get list of all allocated interfaces.
    pub fn enumerate_interfaces(self: *NetworkInterfaceManager, indices: []u32) u32 {
        Debug.kassert(self.initialized, "Manager not initialized", .{});
        var count: u32 = 0;
        for (&self.interfaces, 0..) |*iface, i| {
            if (iface.allocated and count < indices.len) {
                indices[count] = @as(u32, @intCast(i));
                count += 1;
            }
        }
        return count;
    }

    /// Delete interface.
    /// Why: Remove network interface.
    pub fn delete_interface(self: *NetworkInterfaceManager, idx: u32) bool {
        Debug.kassert(self.initialized, "Manager not initialized", .{});
        if (idx >= MAX_IFACES or !self.interfaces[idx].allocated) {
            self.stats.record_deletion_error();
            return false;
        }
        self.interfaces[idx] = NetworkInterface.init();
        self.stats.record_interface_deleted();
        return true;
    }

    /// Get network interface statistics snapshot.
    /// Why: Provide statistics for userspace queries.
    pub fn get_stats(self: *const NetworkInterfaceManager) *const NetworkInterfaceStats {
        Debug.kassert(self.initialized, "Manager not initialized", .{});
        return &self.stats;
    }
};
