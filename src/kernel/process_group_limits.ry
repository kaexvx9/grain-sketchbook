//! Process Group Resource Limits
//! Why: Enforce resource limits per process group for resource management.

const std = @import("std");
const Debug = @import("debug.zig");

const MAX_ENTRIES: u32 = 64;

/// Resource limit entry for a process group.
/// Why: Track and enforce resource limits per process group.
pub const ProcessGroupLimits = struct {
    pgid: u64,
    max_cpu_time_ns: u64,
    max_memory_bytes: u64,
    max_process_count: u32,
    allocated: bool,

    /// Initialize empty process group limits entry.
    /// Why: Explicit initialization.
    pub fn init() ProcessGroupLimits {
        return ProcessGroupLimits{
            .pgid = 0,
            .max_cpu_time_ns = 0,
            .max_memory_bytes = 0,
            .max_process_count = 0,
            .allocated = false,
        };
    }

    /// Check if CPU time limit is exceeded.
    /// Why: Enforce CPU time limits.
    pub fn is_cpu_time_exceeded(self: *const ProcessGroupLimits, current: u64) bool {
        Debug.kassert(self.allocated, "Entry not allocated", .{});
        return self.max_cpu_time_ns != 0 and current > self.max_cpu_time_ns;
    }

    /// Check if memory limit is exceeded.
    /// Why: Enforce memory limits.
    pub fn is_memory_exceeded(self: *const ProcessGroupLimits, current: u64) bool {
        Debug.kassert(self.allocated, "Entry not allocated", .{});
        return self.max_memory_bytes != 0 and current > self.max_memory_bytes;
    }

    /// Check if process count limit is exceeded.
    /// Why: Enforce process count limits.
    pub fn is_process_count_exceeded(self: *const ProcessGroupLimits, current: u32) bool {
        Debug.kassert(self.allocated, "Entry not allocated", .{});
        return self.max_process_count != 0 and current >= self.max_process_count;
    }
};

/// Process group limits manager.
/// Why: Manage resource limits for all process groups.
pub const ProcessGroupLimitsManager = struct {
    limits: [MAX_ENTRIES]ProcessGroupLimits,
    initialized: bool,

    /// Initialize process group limits manager.
    /// Why: Set up manager state.
    pub fn init() ProcessGroupLimitsManager {
        return ProcessGroupLimitsManager{
            .limits = [_]ProcessGroupLimits{ProcessGroupLimits.init()} ** MAX_ENTRIES,
            .initialized = true,
        };
    }

    /// Get or create limits entry for a process group.
    /// Why: Track limits for a process group.
    pub fn get_or_create_limits(self: *ProcessGroupLimitsManager, pgid: u64) ?*ProcessGroupLimits {
        Debug.kassert(self.initialized, "Manager not initialized", .{});
        Debug.kassert(pgid != 0, "Process group ID is 0", .{});

        // Find existing
        for (&self.limits) |*l| {
            if (l.allocated and l.pgid == pgid) return l;
        }

        // Create new
        for (&self.limits) |*l| {
            if (!l.allocated) {
                l.pgid = pgid;
                l.max_cpu_time_ns = 0;
                l.max_memory_bytes = 0;
                l.max_process_count = 0;
                l.allocated = true;
                return l;
            }
        }
        return null;
    }

    /// Get limits entry for a process group.
    /// Why: Retrieve limits for a process group.
    pub fn get_limits(self: *const ProcessGroupLimitsManager, pgid: u64) ?*const ProcessGroupLimits {
        Debug.kassert(self.initialized, "Manager not initialized", .{});
        for (&self.limits) |*l| {
            if (l.allocated and l.pgid == pgid) return l;
        }
        return null;
    }

    /// Set CPU time limit for a process group.
    /// Why: Configure CPU time limits.
    pub fn set_cpu_time_limit(self: *ProcessGroupLimitsManager, pgid: u64, ns: u64) bool {
        if (self.get_or_create_limits(pgid)) |e| {
            e.max_cpu_time_ns = ns;
            return true;
        }
        return false;
    }

    /// Set memory limit for a process group.
    /// Why: Configure memory limits.
    pub fn set_memory_limit(self: *ProcessGroupLimitsManager, pgid: u64, bytes: u64) bool {
        if (self.get_or_create_limits(pgid)) |e| {
            e.max_memory_bytes = bytes;
            return true;
        }
        return false;
    }

    /// Set process count limit for a process group.
    /// Why: Configure process count limits.
    pub fn set_process_count_limit(self: *ProcessGroupLimitsManager, pgid: u64, count: u32) bool {
        if (self.get_or_create_limits(pgid)) |e| {
            e.max_process_count = count;
            return true;
        }
        return false;
    }

    /// Check if process group can spawn a new process.
    /// Why: Enforce process count limits before spawning.
    pub fn can_spawn_process(self: *const ProcessGroupLimitsManager, pgid: u64, current: u32) bool {
        Debug.kassert(self.initialized, "Manager not initialized", .{});
        if (pgid == 0) return true;
        if (self.get_limits(pgid)) |e| return !e.is_process_count_exceeded(current + 1);
        return true;
    }

    /// Check if process group can allocate memory.
    /// Why: Enforce memory limits before memory allocation.
    pub fn can_allocate_memory(self: *const ProcessGroupLimitsManager, pgid: u64, current: u64, req: u64) bool {
        Debug.kassert(self.initialized, "Manager not initialized", .{});
        if (pgid == 0) return true;
        if (self.get_limits(pgid)) |e| return !e.is_memory_exceeded(current +% req);
        return true;
    }
};
