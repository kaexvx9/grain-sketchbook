//! Platform-Agnostic Time Source
//! Why: Provide a consistent time source for the kernel.

const std = @import("std");
const builtin = @import("builtin");
const Debug = @import("debug.zig");

/// Time source implementation function pointer.
/// Why: Allow platform-specific time source to be injected.
var get_time_ns_impl: *const fn () u64 = default_get_time_ns;

/// Default time source implementation.
/// Why: Provide a default for non-freestanding targets.
fn default_get_time_ns() u64 {
    if (builtin.os.tag == .freestanding) {
        const FIXED_TIME_NS: u64 = 1703000000 * 1000000000;
        return FIXED_TIME_NS;
    } else {
        const now_sec = std.time.timestamp();
        return @as(u64, @intCast(now_sec)) * 1000000000;
    }
}

/// Time source interface.
/// Why: Abstract time source for different platforms.
pub const TimeSource = struct {
    /// Get current time in nanoseconds since epoch.
    /// Why: Provide consistent time value for kernel operations.
    pub fn get_time_ns() u64 {
        return get_time_ns_impl();
    }

    /// Set time source implementation.
    /// Why: Allow platform-specific time source injection.
    pub fn set_implementation(impl: *const fn () u64) void {
        get_time_ns_impl = impl;
    }
};
