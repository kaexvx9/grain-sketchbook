//! Grain Basin Storage Filesystem
//! Why: In-memory filesystem for kernel file I/O operations.

const std = @import("std");
const Debug = @import("debug.zig");

pub const MAX_FILE_SIZE: u32 = 4 * 1024;
pub const MAX_FILENAME_LEN: u32 = 256;
pub const MAX_DIR_ENTRIES: u32 = 16;
const MAX_FILES: u32 = 128;
const MAX_DIRS: u32 = 32;

/// File entry in filesystem.
/// Why: Store file data and metadata.
pub const FileEntry = struct {
    name: [MAX_FILENAME_LEN]u8,
    name_len: u32,
    data: [MAX_FILE_SIZE]u8,
    data_len: u32,
    allocated: bool,

    /// Initialize empty file entry.
    /// Why: Explicit initialization.
    pub fn init() FileEntry {
        return FileEntry{
            .name = [_]u8{0} ** MAX_FILENAME_LEN,
            .name_len = 0,
            .data = [_]u8{0} ** MAX_FILE_SIZE,
            .data_len = 0,
            .allocated = false,
        };
    }

    /// Set file name.
    /// Why: Update file name with validation.
    pub fn set_name(self: *FileEntry, name: []const u8) bool {
        if (name.len == 0 or name.len >= MAX_FILENAME_LEN) return false;
        @memcpy(self.name[0..name.len], name);
        self.name[name.len] = 0;
        self.name_len = @as(u32, @intCast(name.len));
        return true;
    }

    /// Write data to file.
    /// Why: Update file contents.
    pub fn write(self: *FileEntry, data: []const u8) u32 {
        Debug.kassert(self.allocated, "File not allocated", .{});
        if (data.len > MAX_FILE_SIZE) return 0;
        @memcpy(self.data[0..data.len], data);
        self.data_len = @as(u32, @intCast(data.len));
        return self.data_len;
    }

    /// Read data from file.
    /// Why: Get file contents.
    pub fn read(self: *const FileEntry, buf: []u8) u32 {
        Debug.kassert(self.allocated and buf.len >= MAX_FILE_SIZE, "Invalid state", .{});
        const n = @min(self.data_len, @as(u32, @intCast(buf.len)));
        @memcpy(buf[0..n], self.data[0..n]);
        return n;
    }

    /// Get file size.
    /// Why: Query file size without reading.
    pub fn get_size(self: *const FileEntry) u32 {
        Debug.kassert(self.allocated, "File not allocated", .{});
        return self.data_len;
    }
};

/// Directory entry in filesystem.
/// Why: Store directory structure and file references.
pub const DirectoryEntry = struct {
    name: [MAX_FILENAME_LEN]u8,
    name_len: u32,
    file_indices: [MAX_DIR_ENTRIES]u32,
    file_count: u32,
    allocated: bool,

    /// Initialize empty directory entry.
    /// Why: Explicit initialization.
    pub fn init() DirectoryEntry {
        return DirectoryEntry{
            .name = [_]u8{0} ** MAX_FILENAME_LEN,
            .name_len = 0,
            .file_indices = [_]u32{0} ** MAX_DIR_ENTRIES,
            .file_count = 0,
            .allocated = false,
        };
    }

    /// Set directory name.
    /// Why: Update directory name with validation.
    pub fn set_name(self: *DirectoryEntry, name: []const u8) bool {
        if (name.len == 0 or name.len >= MAX_FILENAME_LEN) return false;
        @memcpy(self.name[0..name.len], name);
        self.name[name.len] = 0;
        self.name_len = @as(u32, @intCast(name.len));
        return true;
    }

    /// Add file to directory.
    /// Why: Track file in directory.
    pub fn add_file(self: *DirectoryEntry, file_idx: u32) bool {
        Debug.kassert(self.allocated and file_idx != 0, "Invalid state", .{});
        if (self.file_count >= MAX_DIR_ENTRIES) return false;
        self.file_indices[self.file_count] = file_idx;
        self.file_count += 1;
        return true;
    }

    /// Get file count.
    /// Why: Query number of files in directory.
    pub fn get_file_count(self: *const DirectoryEntry) u32 {
        Debug.kassert(self.allocated, "Directory not allocated", .{});
        return self.file_count;
    }
};

/// Storage filesystem for kernel.
/// Why: Manage files and directories for file I/O syscalls.
pub const Storage = struct {
    files: [MAX_FILES]FileEntry,
    file_count: u32,
    next_file_index: u32,
    directories: [MAX_DIRS]DirectoryEntry,
    directory_count: u32,
    next_directory_index: u32,

    /// Initialize storage filesystem.
    /// Why: Set up filesystem state.
    pub fn init() Storage {
        return Storage{
            .files = [_]FileEntry{FileEntry.init()} ** MAX_FILES,
            .file_count = 0,
            .next_file_index = 1,
            .directories = [_]DirectoryEntry{DirectoryEntry.init()} ** MAX_DIRS,
            .directory_count = 0,
            .next_directory_index = 1,
        };
    }

    /// Create file.
    /// Why: Allocate file entry for new file.
    pub fn create_file(self: *Storage, name: []const u8) u32 {
        if (name.len == 0) return 0;
        for (&self.files) |*f| {
            if (!f.allocated) {
                if (!f.set_name(name)) return 0;
                f.allocated = true;
                f.data_len = 0;
                self.file_count += 1;
                const idx = self.next_file_index;
                self.next_file_index += 1;
                return idx;
            }
        }
        return 0;
    }

    /// Find file by name.
    /// Why: Look up file for read/write operations.
    pub fn find_file(self: *const Storage, name: []const u8) u32 {
        if (name.len == 0) return 0;
        for (&self.files, 0..) |*f, i| {
            if (f.allocated and f.name_len == name.len) {
                if (std.mem.eql(u8, f.name[0..f.name_len], name)) return @as(u32, @intCast(i)) + 1;
            }
        }
        return 0;
    }

    /// Get file by index.
    /// Why: Access file entry by index.
    pub fn get_file(self: *Storage, idx: u32) ?*FileEntry {
        if (idx == 0 or idx > MAX_FILES) return null;
        const i = idx - 1;
        if (!self.files[i].allocated) return null;
        return &self.files[i];
    }

    /// Delete file.
    /// Why: Remove file from filesystem.
    pub fn delete_file(self: *Storage, idx: u32) bool {
        if (idx == 0 or idx > MAX_FILES) return false;
        const i = idx - 1;
        if (!self.files[i].allocated) return false;
        self.files[i].allocated = false;
        self.files[i].name_len = 0;
        self.files[i].data_len = 0;
        self.file_count -= 1;
        return true;
    }

    /// Create directory.
    /// Why: Allocate directory entry for new directory.
    pub fn create_directory(self: *Storage, name: []const u8) u32 {
        if (name.len == 0) return 0;
        for (&self.directories) |*d| {
            if (!d.allocated) {
                if (!d.set_name(name)) return 0;
                d.allocated = true;
                d.file_count = 0;
                self.directory_count += 1;
                const idx = self.next_directory_index;
                self.next_directory_index += 1;
                return idx;
            }
        }
        return 0;
    }

    /// Get file count.
    /// Why: Query number of allocated files.
    pub fn get_file_count(self: *const Storage) u32 {
        return self.file_count;
    }

    /// Get directory count.
    /// Why: Query number of allocated directories.
    pub fn get_directory_count(self: *const Storage) u32 {
        return self.directory_count;
    }
};

test "storage init" {
    const s = Storage.init();
    try std.testing.expect(s.file_count == 0);
    try std.testing.expect(s.directory_count == 0);
}

test "storage create file" {
    var s = Storage.init();
    const idx = s.create_file("test.txt");
    try std.testing.expect(idx != 0);
    try std.testing.expect(s.file_count == 1);
}

test "storage file write read" {
    var s = Storage.init();
    const idx = s.create_file("test.txt");
    const f = s.get_file(idx);
    try std.testing.expect(f != null);
    const data = "Hello";
    try std.testing.expect(f.?.write(data) == data.len);
    var buf: [MAX_FILE_SIZE]u8 = undefined;
    try std.testing.expect(f.?.read(&buf) == data.len);
}

test "storage find file" {
    var s = Storage.init();
    const idx = s.create_file("test.txt");
    try std.testing.expect(s.find_file("test.txt") == idx);
    try std.testing.expect(s.find_file("nope.txt") == 0);
}

test "storage delete file" {
    var s = Storage.init();
    const idx = s.create_file("test.txt");
    try std.testing.expect(s.delete_file(idx));
    try std.testing.expect(s.file_count == 0);
}

test "storage create directory" {
    var s = Storage.init();
    const idx = s.create_directory("test_dir");
    try std.testing.expect(idx != 0);
    try std.testing.expect(s.directory_count == 1);
}
