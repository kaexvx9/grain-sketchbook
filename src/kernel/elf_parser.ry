//! ELF Parser for Kernel
//! Why: Parse ELF headers to extract entry point and segment information.

const std = @import("std");
const Debug = @import("debug.zig");

const ELF_MAGIC = [_]u8{ 0x7F, 'E', 'L', 'F' };

fn read_le_u16(buf: []const u8, off: u32) ?u16 {
    if (buf.len < off + 2) return null;
    return @as(u16, buf[off]) | (@as(u16, buf[off + 1]) << 8);
}

fn read_le_u32(buf: []const u8, off: u32) ?u32 {
    if (buf.len < off + 4) return null;
    return @as(u32, buf[off]) | (@as(u32, buf[off + 1]) << 8) |
        (@as(u32, buf[off + 2]) << 16) | (@as(u32, buf[off + 3]) << 24);
}

fn read_le_u64(buf: []const u8, off: u32) ?u64 {
    if (buf.len < off + 8) return null;
    var v: u64 = 0;
    var i: u32 = 0;
    while (i < 8) : (i += 1) {
        v |= (@as(u64, buf[off + i]) << @as(u6, @intCast(i * 8)));
    }
    return v;
}

fn validate_elf_magic(buf: []const u8) bool {
    if (buf.len < 64) return false;
    if (buf[0] != ELF_MAGIC[0] or buf[1] != ELF_MAGIC[1]) return false;
    if (buf[2] != ELF_MAGIC[2] or buf[3] != ELF_MAGIC[3]) return false;
    if (buf[4] != 2 or buf[5] != 1) return false;
    return true;
}

/// ELF parser result.
/// Why: Return parsed ELF information for process setup.
pub const ElfInfo = struct {
    entry_point: u64,
    valid: bool,
    phoff: u64,
    phentsize: u16,
    phnum: u16,

    /// Initialize empty ELF info.
    /// Why: Explicit initialization.
    pub fn init() ElfInfo {
        return ElfInfo{ .entry_point = 0, .valid = false, .phoff = 0, .phentsize = 0, .phnum = 0 };
    }
};

/// Parse ELF header from memory buffer.
/// Why: Extract entry point and validate ELF format for process spawning.
pub fn parse_elf_header(buf: []const u8) ElfInfo {
    Debug.kassert(buf.len > 0, "Buffer empty", .{});
    if (!validate_elf_magic(buf)) return ElfInfo.init();

    const entry = read_le_u64(buf, 24) orelse return ElfInfo.init();
    if (entry == 0 or entry > 0xFFFFFFFFFFFF) return ElfInfo.init();

    const phoff = read_le_u64(buf, 32) orelse return ElfInfo.init();
    const phentsize = read_le_u16(buf, 54) orelse return ElfInfo.init();
    const phnum = read_le_u16(buf, 56) orelse return ElfInfo.init();

    if (phentsize != 0 and phentsize < 56) return ElfInfo.init();
    if (phnum > 128) return ElfInfo.init();

    return ElfInfo{
        .entry_point = entry,
        .valid = true,
        .phoff = phoff,
        .phentsize = phentsize,
        .phnum = phnum,
    };
}

/// Program segment information.
/// Why: Track segment details for loading into VM memory.
pub const ProgramSegment = struct {
    p_type: u32,
    p_vaddr: u64,
    p_filesz: u64,
    p_memsz: u64,
    p_flags: u32,
    p_offset: u64,
    p_align: u64,
    valid: bool,

    /// Initialize empty segment.
    /// Why: Explicit initialization.
    pub fn init() ProgramSegment {
        return ProgramSegment{
            .p_type = 0,
            .p_vaddr = 0,
            .p_filesz = 0,
            .p_memsz = 0,
            .p_flags = 0,
            .p_offset = 0,
            .p_align = 0,
            .valid = false,
        };
    }
};

/// Parse program header from memory buffer.
/// Why: Extract segment information for loading into VM memory.
pub fn parse_program_header(buf: []const u8) ProgramSegment {
    Debug.kassert(buf.len > 0, "Buffer empty", .{});
    if (buf.len < 56) return ProgramSegment.init();

    const p_type = read_le_u32(buf, 0) orelse return ProgramSegment.init();
    const p_flags = read_le_u32(buf, 4) orelse return ProgramSegment.init();
    const p_offset = read_le_u64(buf, 8) orelse return ProgramSegment.init();
    const p_vaddr = read_le_u64(buf, 16) orelse return ProgramSegment.init();
    const p_filesz = read_le_u64(buf, 32) orelse return ProgramSegment.init();
    const p_memsz = read_le_u64(buf, 40) orelse return ProgramSegment.init();
    const p_align = read_le_u64(buf, 48) orelse return ProgramSegment.init();

    if (!validate_segment(p_type, p_vaddr, p_filesz, p_memsz, p_align)) {
        return ProgramSegment.init();
    }

    return ProgramSegment{
        .p_type = p_type,
        .p_vaddr = p_vaddr,
        .p_filesz = p_filesz,
        .p_memsz = p_memsz,
        .p_flags = p_flags,
        .p_offset = p_offset,
        .p_align = p_align,
        .valid = true,
    };
}

fn validate_segment(p_type: u32, p_vaddr: u64, p_filesz: u64, p_memsz: u64, p_align: u64) bool {
    if (p_type != 1) return false;
    if (p_vaddr == 0 or p_vaddr > 0xFFFFFFFFFFFF) return false;
    if (p_memsz < p_filesz) return false;
    if (p_align != 0 and (p_align & (p_align - 1)) != 0) return false;
    return true;
}
