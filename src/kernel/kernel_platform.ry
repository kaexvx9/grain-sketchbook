//! Kernel Platform Module
//! Why: Export platform abstraction for testing.

const sbi = @import("sbi");
const basin_kernel = @import("basin_kernel");
const Debug = basin_kernel.Debug;
pub const platform = basin_kernel.platform;

/// RISC-V platform wrapper.
/// Why: Re-implement platform_riscv for module context.
pub const platform_riscv = struct {
    /// Map unified platform functions to RISC-V SBI calls.
    /// Why: Abstract SBI behind platform-agnostic interface.
    pub fn platform_call_riscv(
        function_id: platform.PlatformFunction,
        arg0: u64,
        arg1: u64,
        arg2: u64,
        arg3: u64,
    ) platform.PlatformResult {
        _ = arg1;
        _ = arg2;
        _ = arg3;

        return switch (function_id) {
            .console_putchar => {
                Debug.kassert(arg0 <= 0xFF, "Character out of range", .{});
                _ = sbi.console_putchar(@truncate(arg0));
                return .{ .error_code = 0, .value = 0 };
            },
            .console_getchar => {
                const result = sbi.console_getchar();
                return switch (result) {
                    .NoChar => .{ .error_code = -1, .value = -1 },
                    .Char => |c| .{ .error_code = 0, .value = @intCast(c) },
                };
            },
            .set_timer => {
                sbi.set_timer(arg0);
                return .{ .error_code = 0, .value = 0 };
            },
            .shutdown => {
                sbi.shutdown();
                unreachable;
            },
        };
    }

    /// Get current time in nanoseconds since epoch.
    /// Why: Provide time source for freestanding RISC-V kernel.
    pub fn get_time_ns() u64 {
        const FIXED_TIME_NS: u64 = 1703000000 * 1000000000;
        return FIXED_TIME_NS;
    }
};
