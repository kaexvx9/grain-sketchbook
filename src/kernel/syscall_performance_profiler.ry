//! Syscall Performance Profiler
//! Why: Track syscall execution times to identify hot paths and optimize performance.

const std = @import("std");
const Debug = @import("debug.zig");

pub const MAX_SYSCALLS: u32 = 150;

/// Syscall performance metrics.
/// Why: Track timing and call count for each syscall.
pub const SyscallMetrics = struct {
    call_count: u64,
    total_time_ns: u64,
    min_time_ns: u64,
    max_time_ns: u64,

    /// Initialize syscall metrics.
    /// Why: Set up metrics with zero counters.
    pub fn init() SyscallMetrics {
        return SyscallMetrics{ .call_count = 0, .total_time_ns = 0, .min_time_ns = 0, .max_time_ns = 0 };
    }

    /// Record syscall execution time.
    /// Why: Update metrics with execution time.
    pub fn record_execution(self: *SyscallMetrics, time_ns: u64) void {
        Debug.kassert(time_ns > 0, "Time is zero", .{});
        self.call_count += 1;
        self.total_time_ns += time_ns;
        if (self.call_count == 1) {
            self.min_time_ns = time_ns;
            self.max_time_ns = time_ns;
        } else {
            if (time_ns < self.min_time_ns) self.min_time_ns = time_ns;
            if (time_ns > self.max_time_ns) self.max_time_ns = time_ns;
        }
    }

    /// Get average execution time (nanoseconds).
    /// Why: Calculate average for performance analysis.
    pub fn get_average_time_ns(self: *const SyscallMetrics) u64 {
        if (self.call_count == 0) return 0;
        return self.total_time_ns / self.call_count;
    }
};

/// Entry for top syscalls result.
/// Why: Track syscall number and metric for ranking.
pub const TopEntry = struct { syscall_num: u32, value: u64 };

/// Syscall performance profiler.
/// Why: Track performance metrics for all syscalls.
pub const SyscallPerformanceProfiler = struct {
    metrics: [MAX_SYSCALLS]SyscallMetrics = [_]SyscallMetrics{SyscallMetrics.init()} ** MAX_SYSCALLS,
    enabled: bool,

    /// Initialize profiler.
    /// Why: Set up profiler with disabled state.
    pub fn init() SyscallPerformanceProfiler {
        return SyscallPerformanceProfiler{
            .metrics = [_]SyscallMetrics{SyscallMetrics.init()} ** MAX_SYSCALLS,
            .enabled = false,
        };
    }

    /// Enable profiling.
    /// Why: Turn on profiling when needed.
    pub fn enable(self: *SyscallPerformanceProfiler) void {
        self.enabled = true;
    }

    /// Disable profiling.
    /// Why: Turn off profiling to reduce overhead.
    pub fn disable(self: *SyscallPerformanceProfiler) void {
        self.enabled = false;
    }

    /// Record syscall execution time.
    /// Why: Update metrics for a syscall execution.
    pub fn record_syscall(self: *SyscallPerformanceProfiler, num: u32, time_ns: u64) void {
        if (!self.enabled) return;
        Debug.kassert(num < MAX_SYSCALLS and time_ns > 0, "Invalid args", .{});
        self.metrics[num].record_execution(time_ns);
    }

    /// Get metrics for a syscall.
    /// Why: Query performance metrics for analysis.
    pub fn get_metrics(self: *const SyscallPerformanceProfiler, num: u32) ?*const SyscallMetrics {
        if (num >= MAX_SYSCALLS) return null;
        return &self.metrics[num];
    }

    /// Reset all metrics.
    /// Why: Clear metrics for new measurement period.
    pub fn reset(self: *SyscallPerformanceProfiler) void {
        for (&self.metrics) |*m| m.* = SyscallMetrics.init();
    }

    /// Get total syscall count across all syscalls.
    /// Why: Provide aggregate statistics for analysis.
    pub fn get_total_syscall_count(self: *const SyscallPerformanceProfiler) u64 {
        var total: u64 = 0;
        for (&self.metrics) |*m| total += m.call_count;
        return total;
    }

    /// Get total execution time across all syscalls (nanoseconds).
    /// Why: Provide aggregate statistics for analysis.
    pub fn get_total_execution_time_ns(self: *const SyscallPerformanceProfiler) u64 {
        var total: u64 = 0;
        for (&self.metrics) |*m| total += m.total_time_ns;
        return total;
    }

    /// Find syscall with highest call count (hot path).
    /// Why: Identify most frequently called syscall.
    pub fn find_hot_path(self: *const SyscallPerformanceProfiler) ?TopEntry {
        var best: ?TopEntry = null;
        for (&self.metrics, 0..) |*m, i| {
            if (m.call_count > 0 and (best == null or m.call_count > best.?.value)) {
                best = TopEntry{ .syscall_num = @intCast(i), .value = m.call_count };
            }
        }
        return best;
    }

    /// Find syscall with highest average execution time (slow path).
    /// Why: Identify slowest syscall for optimization.
    pub fn find_slow_path(self: *const SyscallPerformanceProfiler) ?TopEntry {
        var best: ?TopEntry = null;
        for (&self.metrics, 0..) |*m, i| {
            const avg = m.get_average_time_ns();
            if (avg > 0 and (best == null or avg > best.?.value)) {
                best = TopEntry{ .syscall_num = @intCast(i), .value = avg };
            }
        }
        return best;
    }

    /// Get top N syscalls by call count.
    /// Why: Identify multiple hot paths for optimization.
    pub fn get_top_by_count(self: *const SyscallPerformanceProfiler, max: u32) struct {
        entries: [MAX_SYSCALLS]TopEntry,
        count: u32,
    } {
        var results: [MAX_SYSCALLS]TopEntry = undefined;
        var n: u32 = 0;
        for (&self.metrics, 0..) |*m, i| {
            if (m.call_count > 0) {
                results[n] = TopEntry{ .syscall_num = @intCast(i), .value = m.call_count };
                n += 1;
            }
        }
        sort_entries(results[0..n]);
        return .{ .entries = results, .count = @min(n, max) };
    }

    /// Get top N syscalls by average execution time.
    /// Why: Identify multiple slow paths for optimization.
    pub fn get_top_by_time(self: *const SyscallPerformanceProfiler, max: u32) struct {
        entries: [MAX_SYSCALLS]TopEntry,
        count: u32,
    } {
        var results: [MAX_SYSCALLS]TopEntry = undefined;
        var n: u32 = 0;
        for (&self.metrics, 0..) |*m, i| {
            const avg = m.get_average_time_ns();
            if (avg > 0) {
                results[n] = TopEntry{ .syscall_num = @intCast(i), .value = avg };
                n += 1;
            }
        }
        sort_entries(results[0..n]);
        return .{ .entries = results, .count = @min(n, max) };
    }
};

/// Sort entries by value descending.
/// Why: Helper for ranking syscalls.
fn sort_entries(entries: []TopEntry) void {
    var swapped: bool = true;
    var pass: u32 = 0;
    while (swapped and pass < entries.len) : (pass += 1) {
        swapped = false;
        var i: u32 = 0;
        while (i + 1 < entries.len - pass) : (i += 1) {
            if (entries[i].value < entries[i + 1].value) {
                const tmp = entries[i];
                entries[i] = entries[i + 1];
                entries[i + 1] = tmp;
                swapped = true;
            }
        }
    }
}

test "profiler init" {
    const p = SyscallPerformanceProfiler.init();
    try std.testing.expect(!p.enabled);
    try std.testing.expect(p.metrics[0].call_count == 0);
}

test "profiler enable disable" {
    var p = SyscallPerformanceProfiler.init();
    p.enable();
    try std.testing.expect(p.enabled);
    p.disable();
    try std.testing.expect(!p.enabled);
}

test "profiler record syscall" {
    var p = SyscallPerformanceProfiler.init();
    p.enable();
    p.record_syscall(10, 1000);
    const m = p.get_metrics(10);
    try std.testing.expect(m != null);
    try std.testing.expect(m.?.call_count == 1);
}

test "profiler average time" {
    var p = SyscallPerformanceProfiler.init();
    p.enable();
    p.record_syscall(10, 1000);
    p.record_syscall(10, 2000);
    p.record_syscall(10, 3000);
    const m = p.get_metrics(10);
    try std.testing.expect(m.?.get_average_time_ns() == 2000);
}
