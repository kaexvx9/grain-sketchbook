//! Kernel Statistics Aggregator
//! Why: Aggregate statistics from all kernel subsystems for unified monitoring.

const std = @import("std");
const Debug = @import("debug.zig");
const TcpSocketStats = @import("tcp_socket_stats.zig").TcpSocketStats;
const UdpSocketStats = @import("udp_socket_stats.zig").UdpSocketStats;
const NetworkInterfaceStats = @import("network_interface_stats.zig").NetworkInterfaceStats;
const AudioDeviceStats = @import("audio_device_stats.zig").AudioDeviceStats;
const SchedulerStats = @import("scheduler_stats.zig").SchedulerStats;
const MemoryStats = @import("memory_stats.zig").MemoryStats;
const PageFaultStats = @import("page_fault_stats.zig").PageFaultStats;

/// Kernel statistics snapshot.
/// Why: Capture statistics from all subsystems at a point in time.
pub const KernelStatsSnapshot = struct {
    tcp_stats: *const TcpSocketStats,
    udp_stats: *const UdpSocketStats,
    network_stats: *const NetworkInterfaceStats,
    audio_stats: *const AudioDeviceStats,
    scheduler_stats: *const SchedulerStats,
    memory_stats: *const MemoryStats,
    page_fault_stats: *const PageFaultStats,
    total_errors: u64,
    total_operations: u64,
    health_score: f64,

    /// Create kernel statistics snapshot.
    /// Why: Capture current statistics state from all subsystems.
    pub fn create(
        tcp: *const TcpSocketStats,
        udp: *const UdpSocketStats,
        net: *const NetworkInterfaceStats,
        audio: *const AudioDeviceStats,
        sched: *const SchedulerStats,
        mem: *const MemoryStats,
        pf: *const PageFaultStats,
    ) KernelStatsSnapshot {
        const errors = tcp.total_connection_errors + tcp.total_send_errors +
            tcp.total_receive_errors + udp.total_send_errors +
            udp.total_receive_errors + net.total_creation_errors +
            net.total_configuration_errors + net.total_deletion_errors +
            audio.total_creation_errors + audio.total_configuration_errors +
            audio.total_io_errors + audio.total_deletion_errors;

        const ops = tcp.total_packets_sent + tcp.total_packets_received +
            tcp.total_connected_transitions + udp.total_datagrams_sent +
            udp.total_datagrams_received + net.total_interfaces_created +
            net.total_ipv4_configurations + net.total_ipv6_configurations +
            audio.total_devices_created + audio.total_volume_changes +
            audio.total_format_changes + sched.total_scheduling_decisions + pf.total_count;

        var score: f64 = 100.0;
        if (ops > 0) {
            const rate = (@as(f64, @floatFromInt(errors)) * 100.0) / @as(f64, @floatFromInt(ops));
            score = if (100.0 - rate < 0.0) 0.0 else 100.0 - rate;
        }

        return KernelStatsSnapshot{
            .tcp_stats = tcp,
            .udp_stats = udp,
            .network_stats = net,
            .audio_stats = audio,
            .scheduler_stats = sched,
            .memory_stats = mem,
            .page_fault_stats = pf,
            .total_errors = errors,
            .total_operations = ops,
            .health_score = score,
        };
    }

    /// Print kernel statistics snapshot.
    /// Why: Display comprehensive system statistics for monitoring.
    pub fn print(self: *const KernelStatsSnapshot) void {
        std.debug.print("\n=== Kernel Statistics Summary ===\n", .{});
        std.debug.print("Total Errors: {}\n", .{self.total_errors});
        std.debug.print("Total Operations: {}\n", .{self.total_operations});
        std.debug.print("System Health Score: {d:.2}%\n", .{self.health_score});
        self.tcp_stats.print_stats();
        self.udp_stats.print_stats();
        self.network_stats.print_stats();
        self.audio_stats.print_stats();
        self.scheduler_stats.print_stats();
        if (self.memory_stats.initialized) {
            std.debug.print("Memory: {d} mapped, {d} unmapped\n", .{
                self.memory_stats.mapped_pages,
                self.memory_stats.unmapped_pages,
            });
        }
        if (self.page_fault_stats.initialized) {
            std.debug.print("Page Faults: {d}\n", .{self.page_fault_stats.total_count});
        }
        std.debug.print("=== End Summary ===\n", .{});
    }
};

test "kernel stats snapshot create" {
    const tcp = TcpSocketStats.init();
    const udp = UdpSocketStats.init();
    const net = NetworkInterfaceStats.init();
    const audio = AudioDeviceStats.init();
    const sched = SchedulerStats.init();
    const mem = MemoryStats.init();
    const pf = PageFaultStats.init();

    const snap = KernelStatsSnapshot.create(&tcp, &udp, &net, &audio, &sched, &mem, &pf);
    try std.testing.expect(snap.total_errors == 0);
    try std.testing.expect(snap.health_score == 100.0);
}
