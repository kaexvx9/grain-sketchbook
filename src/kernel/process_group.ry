//! Process Group and Session Management
//! Why: Organize processes into groups and sessions for better management.

const std = @import("std");
const Debug = @import("debug.zig");
const Process = @import("basin_kernel.zig").Process;

const MAX_GROUPS: u32 = 64;
const MAX_SESSIONS: u32 = 32;

/// Process group entry.
/// Why: Track process group membership and leader.
pub const ProcessGroup = struct {
    pgid: u64,
    sid: u64,
    leader_pid: u64,
    process_count: u32,
    allocated: bool,

    /// Initialize empty process group entry.
    /// Why: Explicit initialization.
    pub fn init() ProcessGroup {
        return ProcessGroup{ .pgid = 0, .sid = 0, .leader_pid = 0, .process_count = 0, .allocated = false };
    }
};

/// Session entry.
/// Why: Track session membership and leader.
pub const Session = struct {
    sid: u64,
    leader_pid: u64,
    group_count: u32,
    allocated: bool,

    /// Initialize empty session entry.
    /// Why: Explicit initialization.
    pub fn init() Session {
        return Session{ .sid = 0, .leader_pid = 0, .group_count = 0, .allocated = false };
    }
};

/// Process group manager.
/// Why: Manage process groups and sessions.
pub const ProcessGroupManager = struct {
    groups: [MAX_GROUPS]ProcessGroup,
    sessions: [MAX_SESSIONS]Session,
    next_pgid: u64,
    next_sid: u64,
    initialized: bool,

    /// Initialize process group manager.
    /// Why: Set up manager state.
    pub fn init() ProcessGroupManager {
        return ProcessGroupManager{
            .groups = [_]ProcessGroup{ProcessGroup.init()} ** MAX_GROUPS,
            .sessions = [_]Session{Session.init()} ** MAX_SESSIONS,
            .next_pgid = 1,
            .next_sid = 1,
            .initialized = true,
        };
    }

    /// Create a new process group.
    /// Why: Create a process group for organizing processes.
    pub fn create_group(self: *ProcessGroupManager, pid: u64, sid: u64, procs: []Process, max: u32) u64 {
        Debug.kassert(self.initialized, "Manager not initialized", .{});
        Debug.kassert(pid != 0 and sid != 0, "Invalid IDs", .{});

        for (&self.groups) |*g| {
            if (!g.allocated) {
                const pgid = self.next_pgid;
                self.next_pgid += 1;
                g.pgid = pgid;
                g.sid = sid;
                g.leader_pid = pid;
                g.process_count = 1;
                g.allocated = true;
                set_proc_group(pid, pgid, procs, max);
                self.inc_session_groups(sid);
                return pgid;
            }
        }
        return 0;
    }

    fn set_proc_group(pid: u64, pgid: u64, procs: []Process, max: u32) void {
        var i: u32 = 0;
        while (i < max) : (i += 1) {
            if (procs[i].allocated and procs[i].id == pid) {
                procs[i].pgid = pgid;
                break;
            }
        }
    }

    fn inc_session_groups(self: *ProcessGroupManager, sid: u64) void {
        for (&self.sessions) |*s| {
            if (s.allocated and s.sid == sid) {
                s.group_count += 1;
                break;
            }
        }
    }

    /// Create a new session.
    /// Why: Create a session for organizing process groups.
    pub fn create_session(self: *ProcessGroupManager, pid: u64) u64 {
        Debug.kassert(self.initialized, "Manager not initialized", .{});
        Debug.kassert(pid != 0, "Process ID is 0", .{});

        for (&self.sessions) |*s| {
            if (!s.allocated) {
                const sid = self.next_sid;
                self.next_sid += 1;
                s.sid = sid;
                s.leader_pid = pid;
                s.group_count = 0;
                s.allocated = true;
                return sid;
            }
        }
        return 0;
    }

    /// Get process group ID for a process.
    /// Why: Query which process group a process belongs to.
    pub fn get_process_group(self: *const ProcessGroupManager, pid: u64, procs: []const Process, max: u32) u64 {
        Debug.kassert(self.initialized, "Manager not initialized", .{});
        var i: u32 = 0;
        while (i < max) : (i += 1) {
            if (procs[i].allocated and procs[i].id == pid) return procs[i].pgid;
        }
        return 0;
    }

    /// Get session ID for a process.
    /// Why: Query which session a process belongs to.
    pub fn get_session(self: *const ProcessGroupManager, pid: u64, procs: []const Process, max: u32) u64 {
        Debug.kassert(self.initialized, "Manager not initialized", .{});
        var i: u32 = 0;
        while (i < max) : (i += 1) {
            if (procs[i].allocated and procs[i].id == pid) return procs[i].sid;
        }
        return 0;
    }

    /// Reset manager state.
    /// Why: Clear manager state.
    pub fn reset(self: *ProcessGroupManager) void {
        Debug.kassert(self.initialized, "Manager not initialized", .{});
        for (&self.groups) |*g| g.* = ProcessGroup.init();
        for (&self.sessions) |*s| s.* = Session.init();
        self.next_pgid = 1;
        self.next_sid = 1;
    }
};

test "process group manager init" {
    const m = ProcessGroupManager.init();
    try std.testing.expect(m.initialized);
    try std.testing.expect(m.next_pgid == 1);
}

test "process group manager create session" {
    var m = ProcessGroupManager.init();
    const sid = m.create_session(1);
    try std.testing.expect(sid == 1);
}
