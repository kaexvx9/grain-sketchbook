//! Grain Basin Process Scheduler
//! Why: Manage process execution, scheduling, and state transitions.

const std = @import("std");
const Debug = @import("debug.zig");
const ProcessState = @import("basin_kernel.zig").ProcessState;
const Process = @import("basin_kernel.zig").Process;
const scheduler_stats = @import("scheduler_stats.zig");
const SchedulerStats = scheduler_stats.SchedulerStats;

/// Process scheduler for Grain Basin kernel.
/// Why: Manage process execution order and state management.
pub const Scheduler = struct {
    current_pid: u64,
    next_index: u32,
    time_slice_remaining: u64,
    initialized: bool,
    stats: SchedulerStats,

    /// Initialize scheduler.
    /// Why: Set up scheduler state.
    pub fn init() Scheduler {
        return Scheduler{
            .current_pid = 0,
            .next_index = 0,
            .time_slice_remaining = 0,
            .initialized = true,
            .stats = SchedulerStats.init(),
        };
    }

    /// Set current running process with time slice.
    /// Why: Update scheduler state when process starts.
    pub fn set_current(self: *Scheduler, pid: u64, time_slice: u64) void {
        Debug.kassert(self.initialized, "Scheduler not initialized", .{});
        Debug.kassert(pid != 0 and time_slice > 0, "Invalid args", .{});
        if (self.current_pid != 0 and self.current_pid != pid) self.stats.record_context_switch();
        self.current_pid = pid;
        self.time_slice_remaining = time_slice;
        self.stats.record_process_scheduled();
    }

    /// Decrement time slice for current process.
    /// Why: Track time slice usage during execution.
    pub fn decrement_time_slice(self: *Scheduler, steps: u64) bool {
        Debug.kassert(self.initialized and self.current_pid != 0, "Invalid state", .{});
        if (self.time_slice_remaining > steps) {
            self.time_slice_remaining -= steps;
            return false;
        }
        self.time_slice_remaining = 0;
        self.stats.record_time_slice_expiration();
        self.stats.record_preemption();
        return true;
    }

    /// Check if current process time slice expired.
    /// Why: Determine if process should be preempted.
    pub fn is_time_slice_expired(self: *const Scheduler) bool {
        Debug.kassert(self.initialized, "Scheduler not initialized", .{});
        return self.time_slice_remaining == 0;
    }

    /// Get remaining time slice for current process.
    /// Why: Query remaining time before preemption.
    pub fn get_time_slice_remaining(self: *const Scheduler) u64 {
        Debug.kassert(self.initialized, "Scheduler not initialized", .{});
        return self.time_slice_remaining;
    }

    /// Get current running process ID.
    /// Why: Query which process is currently executing.
    pub fn get_current(self: *const Scheduler) u64 {
        Debug.kassert(self.initialized, "Scheduler not initialized", .{});
        return self.current_pid;
    }

    /// Clear current running process.
    /// Why: Update scheduler when process exits.
    pub fn clear_current(self: *Scheduler) void {
        Debug.kassert(self.initialized and self.current_pid != 0, "Invalid state", .{});
        self.current_pid = 0;
        self.time_slice_remaining = 0;
    }

    /// Find next runnable process (priority-based with round-robin fallback).
    /// Why: Select highest priority process, using round-robin for same priority.
    pub fn find_next_runnable(self: *Scheduler, procs: []const Process, max: u32) u64 {
        Debug.kassert(self.initialized and max <= procs.len, "Invalid state", .{});

        var best_pri: i8 = 20;
        var best_pid: u64 = 0;
        var best_idx: u32 = 0;
        var found: u32 = 0;

        for (procs[0..max], 0..) |p, i| {
            if (p.id != 0 and p.state == .running) {
                if (p.priority < best_pri) {
                    best_pri = p.priority;
                    best_pid = p.id;
                    best_idx = @intCast(i);
                    found = 1;
                } else if (p.priority == best_pri) {
                    found += 1;
                }
            }
        }

        if (best_pid == 0) return 0;
        if (found == 1) {
            self.next_index = (best_idx + 1) % max;
            self.stats.record_priority_selection();
            self.stats.record_scheduling_decision();
            return best_pid;
        }
        self.stats.record_round_robin_selection();
        self.stats.record_scheduling_decision();
        return self.find_rr(procs, max, best_pri);
    }

    fn find_rr(self: *Scheduler, procs: []const Process, max: u32, pri: i8) u64 {
        var checked: u32 = 0;
        var idx = self.next_index;
        while (checked < max) : (checked += 1) {
            const p = procs[idx];
            if (p.id != 0 and p.state == .running and p.priority == pri) {
                self.next_index = (idx + 1) % max;
                return p.id;
            }
            idx = (idx + 1) % max;
        }
        return 0;
    }

    /// Check if process is current running process.
    /// Why: Validate process state for operations.
    pub fn is_current(self: *const Scheduler, pid: u64) bool {
        Debug.kassert(self.initialized and pid != 0, "Invalid state", .{});
        return self.current_pid == pid;
    }

    /// Get scheduler statistics.
    /// Why: Access scheduler behavior metrics for monitoring.
    pub fn get_stats(self: *const Scheduler) *const SchedulerStats {
        Debug.kassert(self.initialized, "Scheduler not initialized", .{});
        return &self.stats;
    }

    /// Reset scheduler state.
    /// Why: Clear scheduler state.
    pub fn reset(self: *Scheduler) void {
        Debug.kassert(self.initialized, "Scheduler not initialized", .{});
        self.current_pid = 0;
        self.next_index = 0;
        self.time_slice_remaining = 0;
        self.stats.reset();
    }
};

test "scheduler init" {
    const s = Scheduler.init();
    try std.testing.expect(s.initialized);
    try std.testing.expect(s.current_pid == 0);
}

test "scheduler set current" {
    var s = Scheduler.init();
    s.set_current(1, 1000);
    try std.testing.expect(s.get_current() == 1);
    try std.testing.expect(s.get_time_slice_remaining() == 1000);
}

test "scheduler clear current" {
    var s = Scheduler.init();
    s.set_current(1, 1000);
    s.clear_current();
    try std.testing.expect(s.get_current() == 0);
}

test "scheduler decrement time slice" {
    var s = Scheduler.init();
    s.set_current(1, 1000);
    try std.testing.expect(!s.decrement_time_slice(100));
    try std.testing.expect(s.get_time_slice_remaining() == 900);
    try std.testing.expect(s.decrement_time_slice(900));
    try std.testing.expect(s.is_time_slice_expired());
}

test "scheduler reset" {
    var s = Scheduler.init();
    s.set_current(1, 1000);
    s.reset();
    try std.testing.expect(s.get_current() == 0);
    try std.testing.expect(s.next_index == 0);
}
