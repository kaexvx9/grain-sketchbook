//! Basin Kernel Type Definitions
//! Why: Centralized type definitions for kernel API and internal structures.

const std = @import("std");
const Debug = @import("debug.zig");
const SignalTable = @import("signal.zig").SignalTable;
const ProcessContext = @import("process.zig").ProcessContext;

/// Basin Kernel syscall numbers.
/// Why: Explicit syscall enumeration for type safety.
pub const Syscall = enum(u32) {
    spawn = 1, exit = 2, yield = 3, wait = 4,
    map = 10, unmap = 11, protect = 12,
    channel_create = 20, channel_send = 21, channel_recv = 22,
    open = 30, read = 31, write = 32, close = 33, unlink = 34, rename = 35,
    mkdir = 36, opendir = 37, readdir = 38, closedir = 39,
    clock_gettime = 40, sleep_until = 41,
    sysinfo = 50, enumerate_processes = 51, get_process_info = 52, read_kernel_log = 53,
    set_priority = 54, get_priority = 55, setpgid = 56, getpgid = 57, setsid = 58, getsid = 59,
    read_input_event = 60,
    fb_clear = 70, fb_draw_pixel = 71, fb_draw_text = 72,
    kill = 80, signal = 81, sigaction = 82,
    network_create_interface = 90, network_set_state = 91, network_set_ipv4 = 92,
    network_get_interface = 93, network_set_ipv6 = 94, network_delete_interface = 95,
    network_enumerate_interfaces = 96, network_get_stats = 97,
    tcp_socket = 100, tcp_bind = 101, tcp_listen = 102, tcp_accept = 103, tcp_connect = 104,
    tcp_send = 105, tcp_recv = 106, tcp_close = 107, tcp_enumerate_sockets = 108, tcp_get_stats = 109,
    udp_socket = 110, udp_bind = 111, udp_sendto = 112, udp_recvfrom = 113, udp_close = 114,
    udp_enumerate_sockets = 115, udp_get_stats = 116,
    audio_create_device = 120, audio_set_volume = 121, audio_set_mute = 122, audio_set_state = 123,
    audio_set_active_output = 124, audio_set_active_input = 125, audio_set_master_volume = 126,
    audio_set_master_mute = 127, audio_get_device = 128, audio_set_format = 129,
    audio_read = 130, audio_write = 131, audio_enumerate_devices = 132,
    audio_delete_device = 133, audio_get_stats = 134,
    kernel_get_stats = 135, health_check = 136, get_resource_usage = 137,
    udp_sendto_with_timeout = 138, udp_recvfrom_with_timeout = 139,
    set_resource_limit = 140,
};

/// Memory mapping flags.
/// Why: Explicit flags for type safety.
pub const MapFlags = packed struct {
    read: bool = false,
    write: bool = false,
    execute: bool = false,
    shared: bool = false,
    _padding: u28 = 0,

    /// Why: Explicit construction.
    pub fn init(f: struct { read: bool = false, write: bool = false, execute: bool = false, shared: bool = false }) MapFlags {
        return MapFlags{ .read = f.read, .write = f.write, .execute = f.execute, .shared = f.shared, ._padding = 0 };
    }
};

/// File open flags.
/// Why: Explicit flags for type safety.
pub const OpenFlags = packed struct {
    read: bool = false,
    write: bool = false,
    create: bool = false,
    truncate: bool = false,
    _padding: u28 = 0,

    /// Why: Explicit construction.
    pub fn init(f: struct { read: bool = false, write: bool = false, create: bool = false, truncate: bool = false }) OpenFlags {
        return OpenFlags{ .read = f.read, .write = f.write, .create = f.create, .truncate = f.truncate, ._padding = 0 };
    }
};

/// Clock ID for time operations.
/// Why: Explicit clock types.
pub const ClockId = enum(u32) { monotonic = 0, realtime = 1 };

/// Strongly-typed kernel handle.
/// Why: Type safety, prevent handle confusion.
pub const Handle = struct {
    value: u64,

    /// Why: Explicit construction.
    pub fn init(value: u64) Handle {
        Debug.kassert(value != 0, "Handle value must be non-zero", .{});
        return Handle{ .value = value };
    }

    /// Why: Explicit validation.
    pub fn is_valid(self: Handle) bool {
        return self.value != 0;
    }

    /// Why: Explicit comparison.
    pub fn eql(self: Handle, other: Handle) bool {
        return self.value == other.value;
    }
};

/// System information structure.
/// Why: Strongly-typed struct for system info.
pub const SysInfo = struct {
    total_memory: u64,
    available_memory: u64,
    used_memory: u64,
    cpu_cores: u32,
    uptime_ns: u64,
    load_avg_1min: u32,
    total_processes: u32,
    running_processes: u32,
    exited_processes: u32,

    /// Why: Explicit initialization.
    pub fn init() SysInfo {
        return SysInfo{
            .total_memory = 0, .available_memory = 0, .used_memory = 0,
            .cpu_cores = 0, .uptime_ns = 0, .load_avg_1min = 0,
            .total_processes = 0, .running_processes = 0, .exited_processes = 0,
        };
    }
};

/// Process information for userspace.
/// Why: Provide process information to userspace.
pub const ProcessInfo = struct {
    pid: u32,
    parent_pid: u32,
    state: u8,
    cpu_time_ns: u64,
    memory_used: u64,

    /// Why: Explicit initialization.
    pub fn init() ProcessInfo {
        return ProcessInfo{ .pid = 0, .parent_pid = 0, .state = 0, .cpu_time_ns = 0, .memory_used = 0 };
    }
};

/// Resource usage information.
/// Why: Expose per-process resource usage.
pub const ResourceUsage = struct {
    pid: u32,
    cpu_time_ns: u64,
    memory_used: u64,
    network_bytes_sent: u64,
    network_bytes_received: u64,
    open_file_descriptors: u32,
    open_connections: u32,

    /// Why: Explicit initialization.
    pub fn init() ResourceUsage {
        return ResourceUsage{
            .pid = 0, .cpu_time_ns = 0, .memory_used = 0,
            .network_bytes_sent = 0, .network_bytes_received = 0,
            .open_file_descriptors = 0, .open_connections = 0,
        };
    }
};

pub const UserId = u32;
pub const GroupId = u32;

/// User Record.
/// Why: Track user identity, permissions, home directory.
pub const User = struct {
    uid: UserId,
    gid: GroupId,
    name: [32]u8,
    home: [256]u8,
    capabilities: u64,

    /// Why: Explicit initialization.
    pub fn init() User {
        return User{ .uid = 0, .gid = 0, .name = [_]u8{0} ** 32, .home = [_]u8{0} ** 256, .capabilities = 0 };
    }

    /// Why: Ensure user data is valid.
    pub fn validate(self: *const User) void {
        Debug.kassert(self.uid < 65536 and self.gid < 65536, "UID/GID too large", .{});
    }
};

/// Current User Context.
/// Why: Track current user for permission checks.
pub const UserContext = struct {
    uid: UserId,
    gid: GroupId,
    euid: UserId,
    egid: GroupId,

    /// Why: Explicit initialization.
    pub fn init(uid: UserId, gid: GroupId) UserContext {
        return UserContext{ .uid = uid, .gid = gid, .euid = uid, .egid = gid };
    }

    /// Why: Explicit root check.
    pub fn is_root(self: *const UserContext) bool {
        return self.euid == 0;
    }

    /// Why: Explicit capability check.
    pub fn has_capability(self: *const UserContext, cap: u64) bool {
        _ = cap;
        return self.is_root();
    }
};

/// Basin Kernel error types.
/// Why: Explicit error types.
pub const BasinError = error{
    invalid_handle, invalid_argument, permission_denied, not_found, out_of_memory,
    resource_exhausted, would_block, interrupted, invalid_syscall, invalid_address,
    unaligned_access, out_of_bounds, user_not_found, invalid_user,
    network_error, connection_failed, connection_timeout, connection_refused, network_timeout,
    file_io_timeout, file_not_found, file_exists, file_too_large, directory_not_empty,
    process_not_found, process_already_running, process_terminated,
    channel_full, channel_empty, channel_closed, ipc_timeout,
    too_many_files, too_many_processes, too_many_connections,
};

/// Syscall result wrapper.
/// Why: Explicit result type.
pub const SyscallResult = union(enum) {
    success: u64,
    err: BasinError,

    /// Why: Explicit construction.
    pub fn ok(value: u64) SyscallResult {
        return SyscallResult{ .success = value };
    }

    /// Why: Explicit construction.
    pub fn fail(e: BasinError) SyscallResult {
        return SyscallResult{ .err = e };
    }
};

/// Process state enumeration.
/// Why: Explicit process states.
pub const ProcessState = enum(u8) { running, exited, free };

/// Memory mapping entry.
/// Why: Track memory mappings.
pub const MemoryMapping = struct {
    address: u64,
    size: u64,
    flags: MapFlags,
    allocated: bool,
    owner_process_id: u32,

    /// Why: Explicit initialization.
    pub fn init() MemoryMapping {
        return MemoryMapping{ .address = 0, .size = 0, .flags = MapFlags.init(.{}), .allocated = false, .owner_process_id = 0 };
    }

    /// Why: Validate no overlapping mappings.
    pub fn overlaps(self: MemoryMapping, addr: u64, size: u64) bool {
        if (!self.allocated) return false;
        return (self.address < addr + size) and (addr < self.address + self.size);
    }
};

/// File handle entry.
/// Why: Track file handles.
pub const FileHandle = struct {
    id: u64,
    path: [256]u8,
    path_len: u32,
    flags: OpenFlags,
    position: u64,
    buffer: [64 * 1024]u8,
    buffer_size: u32,
    allocated: bool,
    owner_process_id: u32,

    /// Why: Explicit initialization.
    pub fn init() FileHandle {
        return FileHandle{
            .id = 0, .path = [_]u8{0} ** 256, .path_len = 0, .flags = OpenFlags.init(.{}),
            .position = 0, .buffer = [_]u8{0} ** (64 * 1024), .buffer_size = 0,
            .allocated = false, .owner_process_id = 0,
        };
    }
};

/// Directory handle entry.
/// Why: Track directory handles.
pub const DirectoryHandle = struct {
    id: u64,
    path: [256]u8,
    path_len: u32,
    position: u32,
    allocated: bool,

    /// Why: Explicit initialization.
    pub fn init() DirectoryHandle {
        return DirectoryHandle{ .id = 0, .path = [_]u8{0} ** 256, .path_len = 0, .position = 0, .allocated = false };
    }
};

pub const MAX_MAPPINGS: u32 = 32;
pub const MAX_HANDLES: u32 = 16;
pub const MAX_DIR_HANDLES: u32 = 8;
pub const MAX_PROCESSES: u32 = 16;
pub const MAX_USERS: u32 = 8;

/// Process entry.
/// Why: Track process information.
pub const Process = struct {
    id: u64,
    state: ProcessState,
    exit_status: u32,
    executable_ptr: u64,
    executable_len: u64,
    entry_point: u64,
    stack_pointer: u64,
    context: ?ProcessContext = null,
    signals: SignalTable,
    cpu_time_ns: u64,
    memory_used: u64,
    network_bytes_sent: u64,
    network_bytes_received: u64,
    open_file_descriptors: u32,
    open_connections: u32,
    max_cpu_time_ns: u64,
    max_memory_bytes: u64,
    max_file_descriptors: u32,
    max_connections: u32,
    parent_pid: u64,
    priority: i8,
    time_slice_quantum: u64,
    pgid: u64,
    sid: u64,
    allocated: bool,

    /// Why: Explicit initialization.
    pub fn init() Process {
        return Process{
            .id = 0, .state = .free, .exit_status = 0,
            .executable_ptr = 0, .executable_len = 0, .entry_point = 0, .stack_pointer = 0,
            .context = null, .signals = SignalTable.init(),
            .cpu_time_ns = 0, .memory_used = 0, .network_bytes_sent = 0, .network_bytes_received = 0,
            .open_file_descriptors = 0, .open_connections = 0,
            .max_cpu_time_ns = 0, .max_memory_bytes = 0, .max_file_descriptors = 0, .max_connections = 0,
            .parent_pid = 0, .priority = 0, .time_slice_quantum = 1000, .pgid = 0, .sid = 0,
            .allocated = false,
        };
    }
};
