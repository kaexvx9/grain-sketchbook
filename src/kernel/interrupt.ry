//! Grain Basin Interrupt Controller
//! Why: Handle interrupts (timer, external, software) for kernel.

const std = @import("std");
const Debug = @import("debug.zig");
const interrupt_types = @import("interrupt_types.zig");

pub const InterruptType = interrupt_types.InterruptType;

/// Interrupt handler function type.
/// Why: Type-safe interrupt handler registration.
pub const InterruptHandler = *const fn (interrupt_type: InterruptType, context: ?*anyopaque) void;

/// Interrupt context (optional data for handler).
/// Why: Allow handlers to access kernel state or device data.
pub const InterruptContext = struct {
    data: ?*anyopaque,
    type_id: u32,
};

/// Interrupt controller for Grain Basin kernel.
/// Why: Central interrupt handling, routing, and dispatch.
pub const InterruptController = struct {
    timer_handler: ?InterruptHandler = null,
    timer_context: ?*anyopaque = null,
    external_handler: ?InterruptHandler = null,
    external_context: ?*anyopaque = null,
    software_handler: ?InterruptHandler = null,
    software_context: ?*anyopaque = null,
    pending: u32 = 0,
    initialized: bool = false,

    /// Initialize interrupt controller.
    /// Why: Set up interrupt controller state.
    pub fn init() InterruptController {
        return InterruptController{
            .timer_handler = null,
            .timer_context = null,
            .external_handler = null,
            .external_context = null,
            .software_handler = null,
            .software_context = null,
            .pending = 0,
            .initialized = true,
        };
    }

    /// Register timer interrupt handler.
    /// Why: Set handler for timer interrupts.
    pub fn register_timer_handler(self: *InterruptController, h: InterruptHandler, ctx: ?*anyopaque) void {
        Debug.kassert(self.initialized, "Not initialized", .{});
        Debug.kassert(@intFromPtr(h) != 0, "Handler null", .{});
        self.timer_handler = h;
        self.timer_context = ctx;
    }

    /// Register external interrupt handler.
    /// Why: Set handler for external interrupts.
    pub fn register_external_handler(self: *InterruptController, h: InterruptHandler, ctx: ?*anyopaque) void {
        Debug.kassert(self.initialized, "Not initialized", .{});
        Debug.kassert(@intFromPtr(h) != 0, "Handler null", .{});
        self.external_handler = h;
        self.external_context = ctx;
    }

    /// Register software interrupt handler.
    /// Why: Set handler for software interrupts.
    pub fn register_software_handler(self: *InterruptController, h: InterruptHandler, ctx: ?*anyopaque) void {
        Debug.kassert(self.initialized, "Not initialized", .{});
        Debug.kassert(@intFromPtr(h) != 0, "Handler null", .{});
        self.software_handler = h;
        self.software_context = ctx;
    }

    /// Handle interrupt (dispatch to registered handler).
    /// Why: Central interrupt dispatch.
    pub fn handle_interrupt(self: *InterruptController, t: InterruptType) void {
        Debug.kassert(self.initialized, "Not initialized", .{});
        switch (t) {
            .timer => if (self.timer_handler) |h| h(t, self.timer_context),
            .external => if (self.external_handler) |h| h(t, self.external_context),
            .software => if (self.software_handler) |h| h(t, self.software_context),
        }
    }

    /// Mark interrupt as pending.
    /// Why: Allow deferred handling.
    pub fn mark_pending(self: *InterruptController, t: InterruptType) void {
        Debug.kassert(self.initialized, "Not initialized", .{});
        const id = @as(u5, @intCast(@intFromEnum(t)));
        self.pending |= (@as(u32, 1) << id);
    }

    /// Process pending interrupts.
    /// Why: Handle deferred interrupts in main loop.
    pub fn process_pending(self: *InterruptController) void {
        Debug.kassert(self.initialized, "Not initialized", .{});
        inline for ([_]InterruptType{ .timer, .external, .software }) |t| {
            const mask = @as(u32, 1) << @intFromEnum(t);
            if ((self.pending & mask) != 0) {
                self.handle_interrupt(t);
                self.pending &= ~mask;
            }
        }
    }

    /// Check if interrupt is pending.
    /// Why: Query pending interrupt state.
    pub fn is_pending(self: *const InterruptController, t: InterruptType) bool {
        Debug.kassert(self.initialized, "Not initialized", .{});
        return (self.pending & (@as(u32, 1) << @as(u5, @intCast(@intFromEnum(t))))) != 0;
    }

    /// Clear pending interrupt.
    /// Why: Clear pending interrupt state.
    pub fn clear_pending(self: *InterruptController, t: InterruptType) void {
        Debug.kassert(self.initialized, "Not initialized", .{});
        self.pending &= ~(@as(u32, 1) << @as(u5, @intCast(@intFromEnum(t))));
    }
};

test "interrupt controller init" {
    const c = InterruptController.init();
    try std.testing.expect(c.initialized);
    try std.testing.expect(c.pending == 0);
}

test "interrupt controller pending" {
    var c = InterruptController.init();
    c.mark_pending(.timer);
    try std.testing.expect(c.is_pending(.timer));
    c.clear_pending(.timer);
    try std.testing.expect(!c.is_pending(.timer));
}
